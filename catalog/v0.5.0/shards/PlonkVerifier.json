  "natspec": {
    "functions": {
      "0x5d484314": {
        "notice": "Verifies a PLONK proof against `vk` for the given public `input`.",
        "dev": "Returns `false` (does not revert) for an invalid proof, an out-of-range public input (`>= SNARK_SCALAR_FIELD`), an off-curve / out-of-range proof point, or a failed pairing. Reverts on structural misuse (empty input) or a failed ecMul/ecAdd/modexp precompile call.",
        "params": {
          "input": "The public inputs, in the circuit's public-signal order.",
          "proof": "The PLONK proof.",
          "vk": "The verifying key for the circuit. MUST be a key the consumer pins (see KEY PINNING above), never one taken from an untrusted caller."
        }
      }
    },
    "notice": "Stateless Diamond facet exposing a GENERIC PLONK verifier over BN254. The verifying key is a parameter, so one deployment verifies proofs for any circuit — a reusable verifier primitive for the ZK privacy modules and consumers who bring PLONK circuits.",
    "dev": "All logic lives in {PlonkVerifierLib}. Pure verification (view): no state beyond the ERC-165 registration written at init. The facet does not authenticate the key it is given: consumers MUST pin it (see KEY PINNING on {IPlonkVerifier})."
  },

  "natspec": {
    "functions": {
      "0xe4aea089": {
        "notice": "Whether `key` is permitted to call `(target, selector)` (honoring wildcards; `ANY_TARGET` does not match the account itself)."
      },
      "0xf4d2a194": {
        "notice": "Whether `key` is registered and currently within its validity window."
      },
      "0xc8337e5a": {
        "notice": "Registers (or replaces) a session key with a validity window + a `(target, selector)` allowlist.",
        "dev": "Admin only. Re-registering a key that was not revoked overwrites the validity window and adds the given permissions to its existing ones. After {revokeSessionKey}, a registration starts clean."
      },
      "0x84f4fc6a": {
        "notice": "Revokes a session key. Admin only.",
        "dev": "Clears the validity window, invalidates every permission granted so far, and deletes the key's spend caps and spent counters. Re-registering the key restores none of them; set its limits again."
      },
      "0x78b6590d": {
        "notice": "The validity window of `key` (`validUntil == 0` means unregistered/revoked)."
      },
      "0xba9735cc": {
        "notice": "Sets a cumulative spend cap for `key` on `token` (native sentinel `0xEee…EEeE`), resetting the spent counter to 0. Admin only. A token with no cap set is uncapped."
      },
      "0xab1c8674": {
        "notice": "The spend cap and amount already spent for `key` on `token`."
      }
    },
    "notice": "Session-key facet. An admin registers scoped, expiring secondary keys (a `(target, selector)` allowlist + validity window); a registered key can then authorize batches through the `ERC7821Executor` signed-`opData` path without holding the owner key.",
    "dev": "Stateless delegator — logic/storage live in {SessionKeyLib}. Enforces expiry, the allowlist (with `ANY_*` wildcards) and per-token cumulative spend limits, with post-batch approval resets on capped tokens. Revoking a key drops its grants and limits."
  },

  "natspec": {
    "functions": {
      "0xe0ab0772": {
        "notice": "Adds liquidity to the pool and mints LP shares to `to`.",
        "params": {
          "amount0Desired": "The desired amount of token0 to deposit.",
          "amount0Min": "The minimum acceptable amount of token0 (slippage guard).",
          "amount1Desired": "The desired amount of token1 to deposit.",
          "amount1Min": "The minimum acceptable amount of token1 (slippage guard).",
          "to": "The recipient of the minted LP shares."
        }
      },
      "0x24a9d853": {
        "notice": "Returns the swap fee in basis points (always 30 = 0.3%)."
      },
      "0x85f8c259": {
        "notice": "Computes the required input amount to receive a specific output amount (with fee).",
        "params": {
          "amountOut": "The desired output amount.",
          "reserveIn": "The reserve of the input token.",
          "reserveOut": "The reserve of the output token."
        }
      },
      "0x054d50d4": {
        "notice": "Computes the output amount given an input amount and pool reserves (with fee).",
        "params": {
          "amountIn": "The input amount.",
          "reserveIn": "The reserve of the input token.",
          "reserveOut": "The reserve of the output token."
        }
      },
      "0x0902f1ac": {
        "notice": "Returns the current reserves and the block timestamp of the last update."
      },
      "0x9c46665c": {
        "notice": "Returns the LP share balance of `account`.",
        "params": {
          "account": "The address to query."
        }
      },
      "0xad615dec": {
        "notice": "Returns the equivalent amount of tokenB given an amount of tokenA at the current ratio.",
        "dev": "Used to compute proportional token amounts for liquidity provision. No fee applied.",
        "params": {
          "amountA": "The amount of tokenA.",
          "reserveA": "The reserve of tokenA.",
          "reserveB": "The reserve of tokenB."
        }
      },
      "0xe39b0eb5": {
        "notice": "Burns LP shares from the caller and returns the underlying tokens to `to`.",
        "params": {
          "amount0Min": "The minimum acceptable amount of token0 (slippage guard).",
          "amount1Min": "The minimum acceptable amount of token1 (slippage guard).",
          "liquidity": "The amount of LP shares to burn.",
          "to": "The recipient of the underlying tokens."
        }
      },
      "0xaa90d54f": {
        "notice": "Swaps an exact input amount for as many output tokens as possible.",
        "params": {
          "amountIn": "The exact amount of input token to sell.",
          "amountOutMin": "The minimum acceptable output amount (slippage guard).",
          "to": "The recipient of the output tokens.",
          "zeroForOne": "True if selling token0 for token1; false if selling token1 for token0."
        }
      },
      "0x0dfe1681": {
        "notice": "Returns the address of the lower-sorted pool token."
      },
      "0xd21220a7": {
        "notice": "Returns the address of the higher-sorted pool token."
      },
      "0x6aedea73": {
        "notice": "Returns the total supply of LP shares."
      }
    },
    "notice": "Stateless Diamond facet for a Uniswap V2-style constant-product AMM.",
    "dev": "All logic lives in ConstantProductLib. This contract is a pure delegator. Deploy as a facet in a Diamond proxy. Initialize via ConstantProductLib.__ConstantProduct_init."
  },

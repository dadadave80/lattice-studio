  "natspec": {
    "functions": {
      "0x280aebcf": {
        "notice": "Returns a feed's configuration.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x69843940": {
        "notice": "Returns the validated raw DIA value and its update timestamp, in DIA's native types.",
        "dev": "Provider-native reader (mirrors {IDIAOracleV2.getValue}); keeps this adapter's ERC-165 id distinct from other read adapters that share the {latestAnswer} selector.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x084d4783": {
        "notice": "Returns the latest price for `key`, normalized to 18 decimals (WAD). Selector matches {IPriceOracleReader.latestAnswer}. Reverts on stale / future / zero value.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x8faa9164": {
        "notice": "Registers a DIA feed under `key`. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "diaKey": "The DIA price key string (non-empty).",
          "key": "The arbitrary feed identifier.",
          "maxStaleness": "Maximum age (seconds); must be non-zero.",
          "oracle": "The DIA OracleV2 contract address (non-zero)."
        }
      },
      "0x2a589908": {
        "notice": "Removes a registered feed. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "key": "The feed identifier to remove."
        }
      }
    },
    "notice": "Diamond facet that reads DIA OracleV2 price feeds through their string-keyed `getValue` API with per-feed staleness configuration and WAD-normalized answers.",
    "dev": "Stateless delegator — all logic and storage live in {DIAAdapterLib}. Consumers inherit this contract and add AccessControl + an initializer."
  },

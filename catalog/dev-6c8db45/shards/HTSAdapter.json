  "natspec": {
    "functions": {
      "0xa7efe348": {
        "notice": "Associates the diamond with `token` so it can hold and receive it."
      },
      "0xd6910d06": {
        "notice": "Burns `amount` units (FT) or the given `serialNumbers` (NFT) from the treasury."
      },
      "0xdeaac2bb": {
        "notice": "Creates a fungible HTS token with the diamond as treasury, auto-renew account, and holder of the admin + supply keys (`delegatableContractId`). `msg.value` pays the network's creation fee.",
        "params": {
          "maxSupply": "Zero for an infinite supply; otherwise the finite cap."
        }
      },
      "0x6830760a": {
        "notice": "Creates a non-fungible HTS token with the diamond as treasury / key holder. `msg.value` pays the fee."
      },
      "0x54771086": {
        "notice": "The HTS tokens this diamond created (it is their treasury and key holder)."
      },
      "0xd5d607b6": {
        "notice": "Dissociates the diamond from `token` (its balance must be zero)."
      },
      "0xcaaf0325": {
        "notice": "HTS token type: 0 fungible, 1 non-fungible."
      },
      "0xd55fe582": {
        "notice": "True if the diamond is associated with `token` (HIP-719 facade `isAssociated()`)."
      },
      "0x20cab858": {
        "notice": "True if `token` is an HTS token (`isToken` on the system contract)."
      },
      "0xe0f4059a": {
        "notice": "Mints `amount` units (FT) or `metadata.length` serials (NFT) to the treasury. Requires the diamond to hold the supply key as a `delegatableContractId` key."
      },
      "0x84ec4652": {
        "notice": "Transfers NFT `serialNumber` of `token` owned by the diamond to `to`."
      },
      "0x75fd1606": {
        "notice": "Transfers `amount` of `token` from the diamond's own balance to `to`."
      },
      "0x5f34cf96": {
        "notice": "Transfers `amount` of `token` from `from` to `to` using the allowance `from` granted the diamond."
      }
    },
    "notice": "Diamond facet that makes the diamond a first-class Hedera Token Service account: association, treasury transfers, and creation / mint / burn of tokens keyed to the diamond.",
    "dev": "Stateless delegator — all logic and storage live in HTSAdapterLib. Consumers inherit this contract and add AccessControl + an initializer. Only meaningful on Hedera (chain ids 295 / 296 / 297 / 298)."
  },

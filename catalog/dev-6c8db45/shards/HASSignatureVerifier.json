  "natspec": {
    "functions": {
      "0xb2526367": {
        "notice": "True if the protobuf `signatureMap` satisfies `account`'s full key structure (key lists and threshold keys included) over the raw `message`."
      },
      "0x249024ac": {
        "notice": "True if `signature` (65 bytes ECDSA or 64 bytes ED25519) is valid over `messageHash` for the simple key of Hedera `account` (an EVM alias or long-zero `0x000…<accountNum>` address)."
      }
    },
    "notice": "Diamond facet exposing HIP-632 native Hedera account signature verification (ED25519 + ECDSA, key lists via the protobuf path) as two never-reverting views.",
    "dev": "Stateless delegator over HASSignatureVerifierLib. Only meaningful on Hedera."
  },

  "natspec": {
    "functions": {
      "0x29ff017c": {
        "notice": "Quote the native cost to relay a message to `recipient` (ERC-7930) with `gasLimit`."
      },
      "0x529dca32": {
        "notice": "Delivery callback invoked by the Wormhole relayer. `sourceAddress` is a universal address."
      },
      "0x1d03ada8": {
        "notice": "Registers an EVM chainId ↔ Wormhole chain-id equivalence (both directions). Admin only."
      },
      "0x997ce1f0": {
        "notice": "Registers a trusted remote gateway adapter for a chain. Admin only."
      },
      "0xa4766700": {
        "notice": "Dispatches a previously-stored pending message via the Wormhole relayer.",
        "params": {
          "gasLimit": "Destination gas limit for delivery.",
          "refundRecipient": "Address to refund unused relay funds to (on this chain).",
          "sendId": "The non-zero id returned by `sendMessage` (no-attribute path)."
        }
      },
      "0xcdfe7f5c": {
        "dev": "Endpoint for creating a new message. If the message requires further (gateway specific) processing before it can be sent to the destination chain, then a non-zero `sendId` must be returned. Otherwise, the message MUST be sent and this function must return 0. * MUST emit a {MessageSent} event. If any of the `attributes` is not supported, this function SHOULD revert with an {UnsupportedAttribute} error. Other errors SHOULD revert with errors not specified in ERC-7786."
      },
      "0xdc680a0f": {
        "dev": "Getter to check whether an attribute is supported or not."
      }
    },
    "notice": "Dual-mode ERC-7786 gateway facet over the Wormhole relayer. Two-phase send (pending + `requestRelay`, or immediate via a `requestRelay` attribute); `receiveWormholeMessages` is the relayer's delivery callback. EVM chains only.",
    "dev": "Stateless delegator — logic/storage live in {WormholeGatewayAdapterLib}. OZ's `immutable` relayer + `Ownable` are converted to ERC-7201 storage + AccessControl; `BitMaps` replay → a plain mapping."
  },

  "natspec": {
    "functions": {
      "0x248a9ca3": {
        "notice": "Gets the admin role that controls a specific role.",
        "params": {
          "_role": "The role identifier to query."
        }
      },
      "0x2f2ff15d": {
        "notice": "Grants a role to an account.",
        "dev": "Only callable by accounts holding the admin role for the target role. Emits a RoleGranted event if the role was not already held by the account.",
        "params": {
          "_account": "The account address to grant the role to.",
          "_role": "The role identifier to grant."
        }
      },
      "0x91d14854": {
        "notice": "Checks whether an account has a specific role.",
        "params": {
          "_account": "The account address to verify.",
          "_role": "The role identifier to check."
        }
      },
      "0x36568abe": {
        "notice": "Renounces a role from the caller's account.",
        "dev": "This allows accounts to lose privileges if compromised (e.g., misplaced keys). Emits a RoleRevoked event if the caller currently holds the role. The _callerConfirmation parameter must match msg.sender for security.",
        "params": {
          "_callerConfirmation": "The caller's address as a confirmation parameter.",
          "_role": "The role identifier to renounce."
        }
      },
      "0xd547741f": {
        "notice": "Revokes a role from an account.",
        "dev": "Only callable by accounts holding the admin role for the target role. Emits a RoleRevoked event if the account currently holds the role.",
        "params": {
          "_account": "The account address to revoke the role from.",
          "_role": "The role identifier to revoke."
        }
      }
    },
    "notice": "AccessControl is a contract module that allows children to implement role-based access control mechanisms. This is a lightweight version that doesn't include enumeration of role members.",
    "dev": "See {AccessControlEnumerable} if you need to enumerate role members."
  },

  "natspec": {
    "functions": {
      "0xb3f6b99a": {
        "notice": "Called by the dedicated operator to deliver randomness.",
        "dev": "Verifies the caller is the configured operator, decodes the request, domain-separates the randomness, clears the pending entry, and emits `RandomnessFulfilled`. Consumer facets should override this to consume the randomness.",
        "params": {
          "dataWithRound": "The opaque payload originally emitted in `RequestedRandomness`.",
          "randomness": "The drand-derived randomness for the requested round."
        }
      },
      "0xe7f43c68": {
        "notice": "Returns the configured dedicated operator."
      },
      "0xdd1e2651": {
        "notice": "Returns the user key associated with a pending request.",
        "params": {
          "requestId": "The adapter-assigned request ID."
        }
      },
      "0x5e3b709f": {
        "notice": "Requests randomness from Gelato VRF.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`. Emits `RequestedRandomness` for the operator.",
        "params": {
          "userKey": "Arbitrary key the caller wants associated with this request."
        }
      },
      "0xb3ab15fb": {
        "notice": "Sets or replaces the dedicated operator.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`. Reverts `GelatoVRFInvalidOperator` if zero.",
        "params": {
          "operator": "The new dedicated operator."
        }
      }
    },
    "notice": "Diamond facet for Gelato VRF (drand-backed) randomness — no on-chain fee.",
    "dev": "Stateless delegator — all logic and storage live in GelatoVRFAdapterLib. This facet handles the request/track layer only. Consumer facets that inherit this contract should override `fulfillRandomness` to act on delivered randomness after calling `super.fulfillRandomness`."
  },

  "natspec": {
    "functions": {
      "0xd196aaee": {
        "notice": "Returns the raw Tellor value bytes and report timestamp read with the feed's dispute buffer.",
        "dev": "Provider-native reader (mirrors {ITellor.getDataBefore}); keeps this adapter's ERC-165 id distinct from other read adapters that share the {latestAnswer} selector.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x280aebcf": {
        "notice": "Returns a feed's configuration.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x084d4783": {
        "notice": "Returns the latest price for `key`, normalized to 18 decimals (WAD). Selector matches {IPriceOracleReader.latestAnswer}. Reverts on missing / stale / future data.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x249fb496": {
        "notice": "Registers a Tellor feed under `key`. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "disputeBuffer": "Seconds subtracted from `block.timestamp` when reading (0 = no buffer).",
          "key": "The arbitrary feed identifier.",
          "maxStaleness": "Maximum age (seconds); must be non-zero.",
          "queryId": "The Tellor query id (non-zero)."
        }
      },
      "0x3b88e4ad": {
        "notice": "Sets the Tellor contract. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "tellor_": "The Tellor contract (non-zero)."
        }
      },
      "0x1959ad5b": {
        "notice": "Returns the Tellor contract address."
      },
      "0x2a589908": {
        "notice": "Removes a registered feed. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "key": "The feed identifier to remove."
        }
      }
    },
    "notice": "Diamond facet exposing the dispute-based Tellor oracle with per-feed dispute-buffer + staleness configuration and WAD-normalized answers. Shares the {IPriceOracleReader} read surface with the other Lattice oracle adapters.",
    "dev": "Stateless delegator — all logic and storage live in {TellorAdapterLib}. Consumers inherit this contract and add AccessControl + an initializer. Reads use Tellor's `getDataBefore` at a dispute buffer offset so disputed values are removed first."
  },

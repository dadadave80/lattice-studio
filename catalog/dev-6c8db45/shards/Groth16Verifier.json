  "natspec": {
    "functions": {
      "0x6d832d8e": {
        "notice": "Verifies a Groth16 proof against `vk` for the given public `input`.",
        "dev": "Returns `false` (does not revert) for an invalid proof, an out-of-range public input (`>= SNARK_SCALAR_FIELD`), an off-curve / out-of-range proof point, or a failed pairing. Reverts only on structural misuse (key/input arity mismatch).",
        "params": {
          "input": "The public inputs, in the circuit's public-signal order.",
          "proof": "The Groth16 proof.",
          "vk": "The verifying key for the circuit."
        }
      }
    },
    "notice": "Stateless Diamond facet exposing a GENERIC Groth16 verifier over BN254. The verifying key is a parameter, so one deployment verifies proofs for any circuit — the primitive the ZK privacy modules plug their circuit's key into.",

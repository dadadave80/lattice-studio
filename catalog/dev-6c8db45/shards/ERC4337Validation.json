  "natspec": {
    "functions": {
      "0xb0d691fe": {
        "notice": "The ERC-4337 EntryPoint trusted to call `validateUserOp`."
      },
      "0x584465f2": {
        "notice": "Sets the trusted EntryPoint. Admin only."
      },
      "0x19822f7c": {
        "notice": "Validates a user operation on behalf of the EntryPoint.",
        "dev": "MUST be gated to `msg.sender == entryPoint`. MUST NOT revert on a signature mismatch — instead return `validationData` with the low bit set (`SIG_VALIDATION_FAILED == 1`). If `missingAccountFunds` is non-zero, the account MUST transfer at least that much to the EntryPoint (`msg.sender`).",
        "params": {
          "missingAccountFunds": "The prefund the account owes the EntryPoint for this op.",
          "userOp": "The packed user operation.",
          "userOpHash": "The EntryPoint-computed hash the signature is over (already domain-bound)."
        }
      }
    },
    "notice": "ERC-4337 validation facet — makes the Diamond a smart account drivable by a configured EntryPoint. `validateUserOp` gates on the EntryPoint, validates the user op signature against the `AccountSigner` owner, and pays the EntryPoint its prefund.",
    "dev": "Stateless delegator — logic/storage live in {ERC4337ValidationLib}. The EntryPoint is configurable (v0.7/v0.8/v0.9) rather than hardcoded."
  },

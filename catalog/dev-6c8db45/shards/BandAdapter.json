  "natspec": {
    "functions": {
      "0x280aebcf": {
        "notice": "Returns a feed's configuration.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x182400b9": {
        "notice": "Returns the validated raw Band reference data for `key`, in Band's native types.",
        "dev": "Provider-native reader (mirrors {IStdReference.getReferenceData}); keeps this adapter's ERC-165 id distinct from other read adapters that share the {latestAnswer} selector.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x084d4783": {
        "notice": "Returns the latest rate for `key`, normalized to 18 decimals (WAD). Selector matches {IPriceOracleReader.latestAnswer}. Reverts on stale / future / zero rate.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0xcf3f0bd3": {
        "notice": "Registers a Band feed under `key`. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "base": "The base symbol (non-empty, e.g. `\"ETH\"`).",
          "key": "The arbitrary feed identifier.",
          "maxStaleness": "Maximum age (seconds); must be non-zero.",
          "quote": "The quote symbol (non-empty, e.g. `\"USD\"`)."
        }
      },
      "0x34bdf2c4": {
        "notice": "Sets the StdReference contract. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "reference_": "The StdReference contract (non-zero)."
        }
      },
      "0x02664b2f": {
        "notice": "Returns the StdReference contract address."
      },
      "0x2a589908": {
        "notice": "Removes a registered feed. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "key": "The feed identifier to remove."
        }
      }
    },
    "notice": "Diamond facet that reads Band Protocol reference data through the single global StdReference contract with per-feed staleness configuration and WAD-normalized answers. Shares the {IPriceOracleReader} read surface with the other Lattice oracle adapters.",
    "dev": "Stateless delegator — all logic and storage live in {BandAdapterLib}. Consumers inherit this contract and add AccessControl + an initializer."
  },

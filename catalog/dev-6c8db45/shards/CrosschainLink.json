  "natspec": {
    "functions": {
      "0x6dd99bde": {
        "notice": "Returns the handler registered for a message tag (zero if none)."
      },
      "0x09b0b794": {
        "notice": "Returns the gateway and counterpart registered for a source chain.",
        "params": {
          "chain": "A \"chain-only\" ERC-7930 interoperable address (empty address)."
        }
      },
      "0xffe32a6e": {
        "notice": "Returns whether a `receiveId` from `gateway` has already been processed (keyed per-gateway, as ERC-7786 only guarantees receiveId uniqueness for the calling gateway)."
      },
      "0x2432ef26": {
        "dev": "Endpoint for receiving cross-chain message. This function may be called directly by the gateway."
      },
      "0xcdfe7f5c": {
        "notice": "Sends a message to the counterpart registered for `chain` via its ERC-7786 gateway.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "attributes": "ERC-7786 gateway attributes (may be empty).",
          "chain": "A \"chain-only\" interoperable address selecting the destination link.",
          "payload": "The message payload (handlers expect a leading 4-byte tag on the receiving side)."
        }
      },
      "0x42b26650": {
        "notice": "Registers a handler for inbound messages whose payload starts with `tag` (zero to clear).",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`."
      },
      "0xf54640d0": {
        "notice": "Registers (or overrides) the gateway + counterpart for the counterpart's source chain.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`. Reverts `CrosschainLinkAlreadyRegistered` if a link exists and `allowOverride` is false.",
        "params": {
          "allowOverride": "Whether to overwrite an existing link for the chain.",
          "counterpart": "The full interoperable address of the remote counterpart.",
          "gateway": "The ERC-7786 gateway for this chain (must implement `supportsAttribute`)."
        }
      }
    },
    "notice": "Diamond facet that owns the single ERC-7786 `receiveMessage` selector. It authenticates the calling gateway + source against a per-chain link registry, de-duplicates `receiveId`, and routes the message to a handler registered for the payload's leading 4-byte tag. Also exposes the send path (`sendMessage`) to a registered counterpart.",
    "dev": "Stateless delegator — all logic and storage live in {CrosschainLinkLib}. Consumers inherit this facet and add AccessControl + an initializer that calls `CrosschainLinkLib.__CrosschainLink_init`."
  },

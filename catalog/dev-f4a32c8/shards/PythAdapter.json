  "natspec": {
    "functions": {
      "0x280aebcf": {
        "notice": "Returns a feed's configuration.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0xd47eed45": {
        "notice": "Returns the fee (wei) required to submit `updateData`.",
        "params": {
          "updateData": "The signed Pyth price-update blobs."
        }
      },
      "0x084d4783": {
        "notice": "Returns the latest price for `key`, normalized to 18 decimals (WAD). Selector matches {IPriceOracleReader.latestAnswer}. Reverts on stale / future / non-positive / wide-confidence.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0xad0ddbee": {
        "notice": "Returns the validated raw price for `key`.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0xf98d06f0": {
        "notice": "Returns the Pyth contract address."
      },
      "0xb364e0d4": {
        "notice": "Registers a Pyth feed under `key`. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "key": "The arbitrary feed identifier.",
          "maxConfBps": "Maximum confidence ratio in basis points (0 = disabled).",
          "maxStaleness": "Maximum age (seconds); must be non-zero.",
          "priceId": "The Pyth price-feed id (non-zero)."
        }
      },
      "0xee22fd6f": {
        "notice": "Sets the Pyth contract. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "pyth_": "The Pyth contract (non-zero)."
        }
      },
      "0x2a589908": {
        "notice": "Removes a registered feed. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "key": "The feed identifier to remove."
        }
      },
      "0xef9e5e28": {
        "notice": "Refreshes on-chain Pyth prices from `updateData`. Permissionless and caller-funded: `msg.value` must be `>= getUpdateFee(updateData)`; any excess is refunded to the caller.",
        "params": {
          "updateData": "The signed Pyth price-update blobs."
        }
      }
    },
    "notice": "Diamond facet exposing pull-based Pyth price feeds with per-feed staleness + confidence configuration and WAD-normalized answers. Shares the {IPriceOracleReader} read surface with the other Lattice oracle adapters.",
    "dev": "Stateless delegator — all logic and storage live in {PythAdapterLib}. Consumers inherit this contract and add AccessControl + an initializer. Prices are refreshed via the payable {updatePriceFeeds}, then read via {latestAnswer}."
  },

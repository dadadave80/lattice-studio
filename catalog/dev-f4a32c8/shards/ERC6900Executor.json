  "natspec": {
    "functions": {
      "0xb61d27f6": {
        "notice": "Executes a single call to `target` with `value`, gated by the caller's runtime validation."
      },
      "0x34fcd5be": {
        "notice": "Executes a batch of calls atomically (any sub-call revert reverts all)."

  "natspec": {
    "functions": {
      "0xa526d83b": {
        "notice": "Grants the guardian role to `guardian`.",
        "dev": "Requires DEFAULT_ADMIN_ROLE. Emits `GuardianAdded`.",
        "params": {
          "guardian": "The address to grant guardian status."
        }
      },
      "0x93c87f03": {
        "notice": "Resumes operations after an emergency stop.",
        "dev": "Requires DEFAULT_ADMIN_ROLE. Reverts with `EmergencyStopNotActive` if not stopped. Emits `EmergencyResumed`."
      },
      "0xb1e3268b": {
        "notice": "Activates the emergency stop.",
        "dev": "Requires the caller to hold the guardian role (EMERGENCY_GUARDIAN_ROLE). Reverts with `EmergencyStopActive` if the stop is already active. Emits `EmergencyStopped`.",
        "params": {
          "reason": "A human-readable description of why the stop is being triggered."
        }
      },
      "0x0c68ba21": {
        "notice": "Returns whether `account` holds the guardian role.",
        "params": {
          "account": "The address to query."
        }
      },
      "0x3f683b6a": {
        "notice": "Returns whether the emergency stop is currently active."
      },
      "0x71404156": {
        "notice": "Revokes the guardian role from `guardian`.",
        "dev": "Requires DEFAULT_ADMIN_ROLE. Emits `GuardianRemoved`.",
        "params": {
          "guardian": "The address to revoke guardian status from."
        }
      },
      "0x5b0b0c07": {
        "notice": "Returns the reason string recorded when the emergency stop was last triggered."
      }
    },
    "notice": "Thin Diamond facet that exposes multi-guardian emergency stop functionality.",

  "natspec": {
    "functions": {
      "0xee8ca3b5": {
        "notice": "Cancels and untracks a Gelato Automate task.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`. Reverts `GelatoAutomateTaskNotFound` if untracked.",
        "params": {
          "taskId": "The task to cancel."
        }
      },
      "0x3323b467": {
        "notice": "Creates and tracks a Gelato Automate task.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "execAddress": "The contract Gelato will call when the task runs.",
          "execDataOrSelector": "The calldata (or selector) to run.",
          "feeToken": "The fee token (address(0) for native; off-chain via 1Balance otherwise).",
          "moduleData": "The modules configuring how/when the task triggers."
        }
      },
      "0xc3f909d4": {
        "notice": "Returns the current Automate configuration."
      },
      "0x0d04218f": {
        "notice": "Returns whether `taskId` is tracked by this adapter.",
        "params": {
          "taskId": "The task ID to query."
        }
      },
      "0xb602024b": {
        "notice": "Sets or replaces the Automate configuration.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`. Reverts `GelatoAutomateInvalidConfig` on a zero field.",
        "params": {
          "automate": "The Gelato Automate contract.",
          "dedicatedMsgSender": "The dedicated msg.sender Gelato execs through (derived off-chain via the OpsProxyFactory for this diamond)."
        }
      }
    },
    "notice": "Diamond facet for Gelato Automate (Web3 Functions) task management.",
    "dev": "Stateless delegator — all logic and storage live in GelatoAutomateAdapterLib. This facet handles the create/track/cancel layer only. Gelato executes a created task through a task-creator-specific dedicated msg.sender; consumer exec entrypoints must gate on it via the library's `requireDedicatedMsgSender` guard."
  },

  "natspec": {
    "functions": {
      "0xe9ae5c53": {
        "notice": "Executes a batch of calls encoded per `mode`.",
        "dev": "Authorization is implementation-defined (this account: self / EntryPoint / admin / signed opData).",
        "params": {
          "executionData": "The encoded calls (and optional opData), per `mode`.",
          "mode": "The execution mode selecting the `executionData` encoding."
        }
      },
      "0xd03c7914": {
        "notice": "Whether `mode` is supported by {execute}.",
        "params": {
          "mode": "The execution mode to query."
        }
      }
    },
    "notice": "ERC-7821 minimal batch executor facet. Executes a batch of calls from the account, authorized for the account itself, the configured ERC-4337 EntryPoint, or a `DEFAULT_ADMIN_ROLE` holder.",
    "dev": "Stateless delegator — logic lives in {ERC7821ExecutorLib}. Following the ERC-7821 reference, execution is gated by authorization only (no reentrancy lock, which would block legitimate self-re-entrant flows). An unauthorized caller may still execute a batch the owner signed off-chain via the opData envelope (replay-protected by the account nonce)."
  },

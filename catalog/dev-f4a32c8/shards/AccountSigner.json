    "functions": {
      "0x8da5cb5b": {
        "notice": "The ECDSA owner. Authoritative only when `signerType() == ECDSA`."
      },
      "0x29ede33c": {
        "notice": "The P256/WebAuthn public key coordinates (zero unless a passkey owner is set)."

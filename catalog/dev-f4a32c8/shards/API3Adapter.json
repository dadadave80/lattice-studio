  "natspec": {
    "functions": {
      "0x280aebcf": {
        "notice": "Returns a feed's configuration.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x084d4783": {
        "notice": "Returns the latest price for `key`, normalized to 18 decimals (WAD). Selector matches {IPriceOracleReader.latestAnswer}. Reverts on stale / future / non-positive value.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x61da1439": {
        "notice": "Returns the validated raw dAPI value and its update timestamp, in API3's native types.",
        "dev": "Provider-native reader (mirrors {IApi3Proxy.read}); keeps this adapter's ERC-165 id distinct from other read adapters that share the {latestAnswer} selector.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x915d3063": {
        "notice": "Registers a dAPI feed under `key`. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "key": "The arbitrary feed identifier.",
          "maxStaleness": "Maximum age (seconds); must be non-zero.",
          "proxy": "The dAPI reader proxy address (non-zero)."
        }
      },
      "0x2a589908": {
        "notice": "Removes a registered feed. Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "key": "The feed identifier to remove."
        }
      }
    },
    "notice": "Diamond facet that reads API3 dAPIs through their reader proxies with per-feed staleness configuration and WAD-normalized answers.",
    "dev": "Stateless delegator — all logic and storage live in {API3AdapterLib}. Consumers inherit this contract and add AccessControl + an initializer."
  },

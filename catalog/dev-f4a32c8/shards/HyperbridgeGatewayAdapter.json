    "functions": {
      "0xe9771716": {
        "notice": "The EVM chainId registered for the state machine id `stateMachineId` (0 = unset)."
      },
      "0xbb0f2a9c": {
        "notice": "Configures a destination's dispatch timeout in seconds. TUNABLE; 0 = no explicit timeout (the host's default handling). Admin only."
      },
      "0x496df793": {
        "notice": "The configured dispatch timeout (seconds) for `chainId` (0 = no explicit timeout — the host's default handling)."
      },
      "0x08d24c0e": {
        "notice": "The host's CURRENT ERC-20 fee token (live passthrough of `IIsmpDispatcher.feeToken()` — never cached; the host can migrate it)."
      },
      "0x3a52ea6e": {
        "notice": "The trusted remote ISMP module (counterpart adapter) registered for `chainId` (empty = unset)."
      },
      "0x134b37c9": {
        "notice": "The Hyperbridge IsmpHost the adapter dispatches to and accepts module callbacks from."
      },
      "0x0fee32ce": {
        "notice": "Called by the `IsmpHost` to notify the module of a new proof-verified POST request."
      },
      "0x44ab20f8": {
        "notice": "Called by the `IsmpHost` to notify the module of a GET response to a previously sent request.",
        "dev": "Never used — the adapter dispatches no GET requests."
      },
      "0xd0fff366": {
        "notice": "Called by the `IsmpHost` to notify the module of a previously sent GET request that timed out.",
        "dev": "Never used — the adapter dispatches no GET requests that could time out."
      },
      "0xbc0dd447": {
        "notice": "Called by the `IsmpHost` to notify the module of a previously sent POST request that timed out."
      },

  "natspec": {
    "functions": {
      "0x280aebcf": {
        "notice": "Returns the registered feed address and staleness threshold for a key.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x084d4783": {
        "notice": "Returns the latest price normalised to 18 decimal places.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0xad0ddbee": {
        "notice": "Returns the raw latest price, its update timestamp, and the feed's decimals.",
        "params": {
          "key": "The feed identifier."
        }
      },
      "0x915d3063": {
        "notice": "Registers a Chainlink price feed under the given key.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`. The feed's `decimals()` is read and cached at registration time.",
        "params": {
          "feed": "Address of the AggregatorV3 contract.",
          "key": "Arbitrary identifier for this feed.",
          "maxStaleness": "Maximum age (seconds) an answer may be before it is considered stale. Must be non-zero."
        }
      },
      "0x2a589908": {
        "notice": "Removes a registered price feed.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`.",
        "params": {
          "key": "The feed identifier to remove."
        }
      }
    },
    "notice": "Diamond facet that exposes Chainlink AggregatorV3 price feeds with per-feed staleness configuration and WAD-normalised answers.",
    "dev": "Stateless delegator — all logic and storage live in ChainlinkAdapterLib. Consumers inherit this contract and add AccessControl + an initializer."
  },

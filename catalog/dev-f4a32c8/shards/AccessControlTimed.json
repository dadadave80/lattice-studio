  "natspec": {
    "functions": {
      "0x248a9ca3": {
        "notice": "Retrieves the admin role that controls access to a specific role.",
        "params": {
          "role": "The role identifier to query."
        }
      },
      "0x2f2ff15d": {
        "notice": "Grants a role to an account.",
        "dev": "Emits a {RoleGranted} event if the account didn't already hold the role. Requirements: - the caller must have the admin role for the target role.",
        "params": {
          "account": "The account address to grant the role to.",
          "role": "The role identifier to grant."
        }
      },
      "0x91d14854": {
        "notice": "Checks whether an account has been granted a specific role.",
        "params": {
          "account": "The account address to check.",
          "role": "The role identifier to verify."
        }
      },
      "0x36568abe": {
        "notice": "Renounces a role from the calling account.",
        "dev": "Allows accounts to lose privileges if compromised (e.g., misplaced keys or compromised devices). Emits a {RoleRevoked} event if the caller currently holds the role. Requirements: - the caller's actual address must match the callerConfirmation parameter for security.",
        "params": {
          "callerConfirmation": "The caller's address as a confirmation parameter.",
          "role": "The role identifier to renounce."
        }
      },
      "0xd547741f": {
        "notice": "Revokes a role from an account.",
        "dev": "Emits a {RoleRevoked} event if the account currently holds the role. Requirements: - the caller must have the admin role for the target role.",
        "params": {
          "account": "The account address to revoke the role from.",
          "role": "The role identifier to revoke."
        }
      }
    },
    "notice": "Diamond facet exposing AccessControl + per-grant (start, expires) windows."
  },

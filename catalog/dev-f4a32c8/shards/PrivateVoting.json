  "natspec": {
    "functions": {
      "0x5fc5999b": {
        "notice": "Creates a poll over `groupId`. Only the group admin may create polls for it.",
        "params": {
          "endTime": "Unix time voting closes (0 = never).",
          "groupId": "The Semaphore group whose members may vote.",
          "numChoices": "Number of options (>= 2).",
          "startTime": "Unix time voting opens (0 = immediately)."
        }
      },
      "0x1a8cbcaa": {
        "notice": "Returns the public configuration of `pollId`."
      },
      "0x91f36633": {
        "notice": "Returns the vote count for `choice` in `pollId`."
      },
      "0x64390ff1": {
        "notice": "Returns whether `nullifier` has already voted in `pollId`."
      },
      "0x9207891d": {
        "notice": "Returns the number of polls created."
      },
      "0xd5d4738f": {
        "notice": "Casts an anonymous ballot in `pollId`. `proof.scope` must equal `pollId` and `proof.message` is the chosen option; the nullifier prevents a second ballot.",
        "params": {
          "pollId": "The poll to vote in.",
          "proof": "The Semaphore proof of membership binding the choice + poll."
        }
      }
    },
    "notice": "Stateless Diamond facet for anonymous one-person-one-vote polling over Semaphore groups: a member casts an anonymous ballot with a Semaphore proof (scope = poll id, message = choice), and the scope-bound nullifier gives each member exactly one vote per poll.",
    "dev": "All logic lives in {PrivateVotingLib}. Composes the {ISemaphore} module (must be present in the same diamond). 1-person-1-vote, not token-weighted."
  },

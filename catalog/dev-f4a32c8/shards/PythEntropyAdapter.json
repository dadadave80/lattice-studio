  "natspec": {
    "functions": {
      "0x24185135": {
        "notice": "Called by the Entropy contract to deliver a random number.",
        "dev": "Verifies the caller is the configured Entropy contract, looks up the user key, clears the pending entry, and emits `RandomNumberFulfilled`. Consumer facets should override this to consume the randomness.",
        "params": {
          "provider": "The provider that fulfilled the request.",
          "randomNumber": "The delivered random number.",
          "sequence": "The Entropy-assigned sequence number."
        }
      },
      "0xc3f909d4": {
        "notice": "Returns the current Entropy configuration."
      },
      "0xced72f87": {
        "notice": "Returns the fee (in wei) required for one request under the current config."
      },
      "0x65b56cd4": {
        "notice": "Returns the user key associated with a pending request.",
        "params": {
          "sequenceNumber": "The Entropy-assigned sequence number."
        }
      },
      "0x8738559f": {
        "notice": "Requests a random number, caller-funded with excess refunded.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE` and send `msg.value >= getFee()`.",
        "params": {
          "userKey": "Arbitrary key the caller wants associated with this request.",
          "userRandomNumber": "The caller's commitment to its half of the randomness."
        }
      },
      "0x861fb568": {
        "notice": "Sets or replaces the Entropy configuration.",
        "dev": "Caller must hold `DEFAULT_ADMIN_ROLE`. Reverts `EntropyInvalidConfig` if entropy is zero.",
        "params": {
          "config": "The new configuration."
        }
      }
    },
    "notice": "Diamond facet for Pyth Entropy on-demand (commit/reveal) randomness.",
    "dev": "Stateless delegator — all logic and storage live in PythEntropyAdapterLib. This facet handles the request/track layer only. Consumer facets that inherit this contract should override `entropyCallback` to act on delivered randomness after calling `super.entropyCallback`."
  },

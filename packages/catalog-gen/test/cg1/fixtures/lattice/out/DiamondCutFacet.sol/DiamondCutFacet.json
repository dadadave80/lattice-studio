ionSelectors\",\"type\":\"bytes4[]\"}],\"indexed\":false,\"internalType\":\"struct FacetCut[]\",\"name\":\"diamondCut\",\"type\":\"tuple[]\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"init\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"name\":\"DiamondCut\",\"type\":\"event\"},{\"inputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"facetAddress\",\"type\":\"address\"},{\"internalType\":\"enum FacetCutAction\",\"name\":\"action\",\"type\":\"uint8\"},{\"internalType\":\"bytes4[]\",\"name\":\"functionSelectors\",\"type\":\"bytes4[]\"}],\"internalType\":\"struct FacetCut[]\",\"name\":\"_diamondCut\",\"type\":\"tuple[]\"},{\"internalType\":\"address\",\"name\":\"_init\",\"type\":\"address\"},{\"internalType\":\"bytes\",\"name\":\"_calldata\",\"type\":\"bytes\"}],\"name\":\"diamondCut\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"exportSelectors\",\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"selectors_\",\"type\":\"bytes\"}],\"stateMutability\":\"pure\",\"type\":\"function\"}],\"devdoc\":{\"author\":\"Nick Mudge (https://github.com/mudgen/diamond-3-hardhat/blob/main/contracts/Diamond.sol)Modified by David Dada <daveproxy80@gmail.com> (https://github.com/dadadave80)\",\"details\":\"Note: Remember to add the loupe functions from DiamondLoupeFacet to the diamond. The loupe functions are required by the EIP2535 Diamonds standard.\",\"errors\":{\"CannotAddFunctionToDiamondThatAlreadyExists(bytes4)\":[{\"params\":{\"selector\":\"The selector that is already present\"}}],\"CannotAddSelectorsToZeroAddress(bytes4[])\":[{\"params\":{\"selectors\":\"The selectors attempted to be added\"}}],\"CannotRemoveFunctionThatDoesNotExist(bytes4)\":[{\"params\":{\"selector\":\"The selector that could not be found\"}}],\"CannotRemoveImmutableFunction(bytes4)\":[{\"params\":{\"selector\":\"The selector of the immutable function\"}}],\"CannotReplaceFunctionWithTheSameFunctionFromTheSameFacet(bytes4)\":[{\"params\":{\"selector\":\"The selector that would result in a no-op replace\"}}],\"InitializeDiamondCutReverted(address,bytes)\":[{\"params\":{\"data\":\"The calldata passed to the init contract\",\"initAddress\":\"The address of the init contract that reverted\"}}],\"NoBytecodeAtAddress(address)\":[{\"params\":{\"contractAddress\":\"The address checked for deployed bytecode\"}}],\"NoSelectorsProvidedForFacetCut(address)\":[{\"params\":{\"facetAddress\":\"The facet contract address for which selectors were expected\"}}],\"RemoveFacetAddressMustBeZeroAddress(address)\":[{\"params\":{\"facetAddress\":\"The address that should have been zero for removals\"}}]},\"events\":{\"DiamondCut((address,uint8,bytes4[])[],address,bytes)\":{\"details\":\"Logged after executing `diamondCut` with its associated initializer.\",\"params\":{\"data\":\"The calldata passed to the `init` address for initialization.\",\"diamondCut\":\"The array of facet cuts specifying facet addresses, actions, and function selectors.\",\"init\":\"The address of the contract or facet to delegatecall for initialization.\"}}},\"kind\":\"dev\",\"methods\":{\"diamondCut((address,uint8,bytes4[])[],address,bytes)\":{\"params\":{\"_calldata\":\"A function call, including function selector and arguments                  _calldata is executed with delegatecall on _init\",\"_diamondCut\":\"Contains the facet addresses and function selectors\",\"_init\":\"The address of the contract or facet to execute _calldata\"}},\"exportSelectors()\":{\"details\":\"The returned length is always a multiple of 4. `exportSelectors` MUST exclude      itself: it is called directly on the facet address, never routed through the      diamond, and every facet declares it (routing it would collide across facets).\",\"returns\":{\"selectors_\":\"The facet's selectors packed as consecutive 4-byte values.\"}}},\"title\":\"DiamondCutFacet\",\"version\":1},\"userdoc\":{\"errors\":{\"CannotAddFunctionToDiamondThatAlreadyExists(bytes4)\":[{\"notice\":\"Thrown when adding a function selector that already exists in the diamond\"}],\"CannotAddSelectorsToZeroAddress(bytes4[])\":[{\"notice\":\"Thrown when trying to add selectors under the zero address (invalid facet)\"}],\"CannotAddThisAddress()\":[{\"notice\":\"Thrown when attempting to add the diamond contract itself as a facet, which is not allowed\"}],\"CannotRemoveFunctionThatDoesNotExist(bytes4)\":[{\"notice\":\"Thrown when attempting to remove a function selector that isn\\u2019t in the diamond\"}],\"CannotRemoveImmutableFunction(bytes4)\":[{\"notice\":\"Thrown when attempting to remove an immutable function\"}],\"CannotReplaceFunctionWithTheSameFunctionFromTheSameFacet(bytes4)\":[{\"notice\":\"Thrown when replacing a function with the same implementation from the same facet\"}],\"InitializeDiamondCutReverted(address,bytes)\":[{\"notice\":\"Thrown when the initialization call following a diamond cut reverts\"}],\"NoBytecodeAtAddress(address)\":[{\"notice\":\"Thrown when verifying a facet contract but finding no deployed bytecode\"}],\"NoSelectorsGivenToAdd()\":[{\"notice\":\"Thrown when attempting a diamond cut with no function selectors specified to add\"}],\"NoSelectorsProvidedForFacetCut(address)\":[{\"notice\":\"Thrown when no function selectors are provided for a given facet in a cut\"}],\"RemoveFacetAddressMustBeZeroAddress(address)\":[{\"notice\":\"Thrown when removing a facet but the facet address provided is non-zero\"}]},\"events\":{\"DiamondCut((address,uint8,bytes4[])[],address,bytes)\":{\"notice\":\"Emitted when a diamond cut (facet add/replace/remove) is executed.\"}},\"kind\":\"user\",\"methods\":{\"diamondCut((address,uint8,bytes4[])[],address,bytes)\":{\"notice\":\"Add/replace/remove any number of functions and optionally execute         a function with delegatecall\"},\"exportSelectors()\":{\"notice\":\"Returns this facet's externally-callable function selectors, ABI-packed.\"}},\"notice\":\"Simple single owner and multiroles authorization mixin.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"lib/diamond-lib/src/facets/DiamondCutFacet.sol\":\"DiamondCutFacet\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1000000},\"remappings\":[\":@diamond-script/=lib/diamond-lib/script/\",\":@diamond-test/=lib/diamond-lib/test/\",\":@diamond/=lib/diamond-lib/src/\",\":@lattice-script/=script/\",\":@lattice-test/=test/\",\":@lattice/=src/\",\":@semaphore/=lib/semaphore/\",\":@zk-kit/lean-imt.sol/=lib/zk-kit/lean-imt/\",\":diamond-lib/=lib/diamond-lib/\",\":forge-std/=lib/forge-std/src/\",\":poseidon-solidity/=lib/poseidon-solidity/\",\":semaphore/=lib/semaphore/\",\":zk-kit/=lib/zk-kit/\"]},\"sources\":{\"lib/diamond-lib/src/facets/DiamondCutFacet.sol\":{\"keccak256\":\"0x994efc278a1a5fa589c7b9683d40c805e437d3a24f8372298b4c2cca91afb909\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://116e7eaefcc16795868abff540050029be82135740cb8b91511620a456c96f99\",\"dweb:/ipfs/QmagRpkwybvB7Rhect2oJuadkSenvHH5Xd7kfQXWvUYfcd\"]},\"lib/diamond-lib/src/interfaces/IDiamondCut.sol\":{\"keccak256\":\"0xf3419c62c88c186b88cc74579be5e1e092fccc906422c624ba31bf17876f79de\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://c5c9d4ec50bb904d052525d127a1d440a99a668520a9bb62c188e94fb1b019a2\",\"dweb:/ipfs/QmXiTxV2MtsbaABLu1zC6mmrefEYzEP7fakdfA4bAmQ9u2\"]},\"lib/diamond-lib/src/interfaces/IFacet.sol\":{\"keccak256\":\"0xdb23d7aaa09cad48c7211cc3af2c04254e830e10b56c1e509d8d8e800bbbee12\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://967898826fa6f4b916b7890e197f0fd697217075c896c567dbb98a2c58c2631e\",\"dweb:/ipfs/QmZwt2TwPYwpkHnbkvicV2gc9viRUuoyJWkiND25aUFYvG\"]},\"lib/diamond-lib/src/libraries/DiamondLib.sol\":{\"keccak256\":\"0x35514b08951296e227cdafd1cb53c787060dbedc24a5c5241bbaa3e81fd77246\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6dac84a8aba7de8e99593f374d0d7093488f5825aa293cd9e584de067188ee1a\",\"dweb:/ipfs/Q
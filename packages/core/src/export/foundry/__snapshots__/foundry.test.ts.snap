// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`exportFoundry snapshot: GovernedVault through factory 1`] = `
"// SPDX-License-Identifier: MIT
// DeployGovernedVault.s.sol: deploys the diamond "GovernedVault" as Lattice Studio composed it.
// Generated by Lattice Studio 0.1.0. The same recipe, catalog and inputs give the same bytes.
//
// Recipe hash: 0xdebb5588007f0eebc5ae92371b5928c6f33cf04998c3d415d4502db9861b909b
// Catalog: Lattice fixture at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79, catalog hash 0xce843be12f8b470d72cd0ddb41df9aed8a0c7d7abad718b34bb8b2731805ff24
// Provisional: Lattice 0.2.0 at dev f4a32c8; v1 targets 0.4.0. Fixture catalog: invented release data.
// Toolchain: Foundry 1.8.3, solc 0.8.36
// Deploys through: LatticeFactory.deploy, one transaction with its init
// Salt: deploying account, scope 0x00 (every-chain), entropy 0x0000000000000000000001
// Chains: 84532, 11155111
//
// Run:
//   forge script DeployGovernedVault.s.sol --rpc-url $RPC_URL --account deployer --broadcast
// On Anvil, fork a supported chain where the shared contracts exist: anvil --fork-url $RPC_URL
//
// Before it broadcasts, the script checks that every shared contract's codehash matches the catalog, that the
// predicted address is empty, and that its own simulation of the deploy finds facets() equal to this plan:
//   ERC20 0.2.0, 5 selectors
//   ERC20Votes 0.2.0, 4 selectors
//   ERC4626 0.2.0, 12 selectors
//   GovernedVault 0.2.0, 11 selectors
//   VaultCore 0.2.0, 7 selectors
//   GovernedDiamondCut 0.2.0, 9 selectors
//   Governor 0.2.0, 32 selectors
//   TimelockController 0.2.0, 18 selectors
//   Votes 0.2.0, 4 selectors
//   EmergencyStop 0.2.0, 7 selectors
//   AccessControl 0.2.0, 5 selectors
//   Receive 0.2.0, 1 selector
//   DiamondLoupeFacet 0.2.0, 4 selectors
//   ERC165Facet 0.2.0, 1 selector
//
// Init: one direct call
//   GovernedVaultInit.init((address,string,string,uint8,uint256,uint48,uint32,uint256,uint256))
// References: "This diamond" is the predicted address; "Deploying account" is the broadcaster.
//
// Verify: the script creates no contract forge could match. Verify the diamond against the published Lattice
// standard JSON, in a Lattice checkout at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79:
//   FOUNDRY_PROFILE=ci forge verify-contract <diamond> src/Lattice.sol:Lattice --verifier sourcify --chain <chain id>
//
// Leaves out:
//   Deploying missing shared contracts: use Deploy missing contracts… in Lattice Studio or the lattice-studio CLI.
pragma solidity ^0.8.30;

import {Script} from "forge-std/Script.sol";
import {console} from "forge-std/console.sol";

// Lattice's diamond types (diamond-lib DiamondLib.sol and ILatticeFactory.sol at the pin), inlined.
enum FacetCutAction {
    Add,
    Replace,
    Remove
}

struct FacetCut {
    address facetAddress;
    FacetCutAction action;
    bytes4[] functionSelectors;
}

struct Facet {
    address facetAddress;
    bytes4[] functionSelectors;
}

struct RecipeEntry {
    bytes32 nameHash;
    uint64 version;
}

interface ILatticeFactory {
    function deploy(
        RecipeEntry[] calldata entries,
        FacetCut[] calldata customCuts,
        address init,
        bytes calldata initCalldata,
        bytes32 salt
    ) external returns (address diamond);

    function predict(address deployer, bytes32 salt) external view returns (address diamond);
}

interface IDiamondLoupe {
    function facets() external view returns (Facet[] memory);
}

struct ChainConfig {
    address factory;
    bytes32 factoryCodehash;
    bytes32 proxyInitCodeHash;
    string proxyCommit;
}

// GovernedVaultInit p: address asset, string name, string symbol, uint8 decimalsOffset, uint256 minDelay, uint48 votingDelay, uint32 votingPeriod, uint256 proposalThreshold, uint256 quorumNumerator
struct GovernedVaultInitP {
    address asset;
    string name;
    string symbol;
    uint8 decimalsOffset;
    uint256 minDelay;
    uint48 votingDelay;
    uint32 votingPeriod;
    uint256 proposalThreshold;
    uint256 quorumNumerator;
}

contract DeployGovernedVault is Script {
    error UnsupportedChain(uint256 chainId, string supportedChains);
    error MissingSharedContracts(string names, string howToDeploy);
    error UnexpectedCode(string contracts);
    error AddressTaken(address predicted);
    error PredictionDiffers(address expected, address actual);
    error FacetsDiffer(uint256 expected, uint256 actual);
    error UnexpectedFacet(address facet);
    error SelectorsDiffer(address facet);

    string internal constant PROJECT = "GovernedVault";
    bytes32 internal constant RECIPE_HASH = 0xdebb5588007f0eebc5ae92371b5928c6f33cf04998c3d415d4502db9861b909b;
    bytes1 internal constant SCOPE = 0x00;
    bytes11 internal constant ENTROPY = 0x0000000000000000000001;
    string internal constant SUPPORTED_CHAINS = "84532, 11155111";
    string internal constant MISSING_HELP =
        "Deploy them first with Deploy missing contracts\\u2026 in Lattice Studio or with the lattice-studio CLI.";

    // Shared contracts, at the addresses and codehashes the catalog pins.
    // ERC20
    address internal constant ERC20_ADDRESS = 0xcEA19e568b017a5DBc2FFBbEc9E37d1b874dF808;
    bytes32 internal constant ERC20_CODEHASH = 0xb2bdd94e24a77f078ecc3d7063e3fb7887a9f398749728cfa17039ff2eddc429;
    // ERC20Votes
    address internal constant ERC20_VOTES_ADDRESS = 0x73f7D19a7722e012E7D3f85DdD214623DE3307c0;
    bytes32 internal constant ERC20_VOTES_CODEHASH = 0x0906f0cc6eadea1f122cd52669dd45f10a3f62436b3fb4351718e5cf67e41396;
    // ERC4626
    address internal constant ERC4626_ADDRESS = 0x920000407eC61a764eb42d336B6aE7504aD96eca;
    bytes32 internal constant ERC4626_CODEHASH = 0x793facbb53d32f1c76ee298b357e54060e9beed4f0791ccbe5edf4ae83e3c26e;
    // GovernedVault
    address internal constant GOVERNED_VAULT_ADDRESS = 0xc6B9Fa301ebA3F1900C636C4f2F79838A1eA80b0;
    bytes32 internal constant GOVERNED_VAULT_CODEHASH =
        0x59a69f7bc0d053900e2ad8887481252f23292315ea86b1446fdef8498f9f1a64;
    // VaultCore
    address internal constant VAULT_CORE_ADDRESS = 0xA278F94902FF5f426436DF7b6621c6c15Cd9798d;
    bytes32 internal constant VAULT_CORE_CODEHASH = 0xb89a2f252dadfd7c0193648e7ebd47d59f542e150b885b7f5c9aa9ecf9e99b53;
    // GovernedDiamondCut
    address internal constant GOVERNED_DIAMOND_CUT_ADDRESS = 0x830D554C069662C55987899D641BdE496c31cDe6;
    bytes32 internal constant GOVERNED_DIAMOND_CUT_CODEHASH =
        0x8f8aa27c654743cf0f3d2de6533eebb2b54a419438494038d96786e7e8ddbc5b;
    // Governor
    address internal constant GOVERNOR_ADDRESS = 0x1A24D23c095E898bEa3abe332dD0788b6A8C0B32;
    bytes32 internal constant GOVERNOR_CODEHASH = 0x48519f73e4631681be03edbc1053d0a6436d342853bb273f85cf4e94c905ed17;
    // TimelockController
    address internal constant TIMELOCK_CONTROLLER_ADDRESS = 0x2BADa24222FB6290fAF96D0f66127A9df12dcee1;
    bytes32 internal constant TIMELOCK_CONTROLLER_CODEHASH =
        0xd971b3fec36e27b456229fb3987d982951814ba7ab5f218c02e206ec5c0d16e7;
    // Votes
    address internal constant VOTES_ADDRESS = 0x9703372cF4AeC92836aB60E4845136dFdf71dD1c;
    bytes32 internal constant VOTES_CODEHASH = 0xdd81f2bfbedaa2eabfa89ceaef8551f7cc3c22f6ce70a688d21fcf6c594d5c7e;
    // EmergencyStop
    address internal constant EMERGENCY_STOP_ADDRESS = 0x0Af4CDFAA22B63C9731652A8Cd603e14f89d07F1;
    bytes32 internal constant EMERGENCY_STOP_CODEHASH =
        0xf280916d758b8ac4a20583c038740275d341dffa4cb55dbf653cfb9400090eef;
    // AccessControl
    address internal constant ACCESS_CONTROL_ADDRESS = 0xC31C375CD6003764be3C0F049587De2a15247fF1;
    bytes32 internal constant ACCESS_CONTROL_CODEHASH =
        0x609e15ee4618e038bb5734dae08499fb76f5cf58cd9b7d1f71abdcc79e9e4b87;
    // Receive
    address internal constant RECEIVE_ADDRESS = 0x96E186Fea88E3cCe88ea390CDEEC846a78606812;
    bytes32 internal constant RECEIVE_CODEHASH = 0x618c1fd98e5806c5b441229b919c384b9846d05410bb885eb04dd0a2d0daa7ab;
    // DiamondLoupeFacet
    address internal constant DIAMOND_LOUPE_FACET_ADDRESS = 0x1398f1E9e9aCD915570Ac58AE98160Abc625325F;
    bytes32 internal constant DIAMOND_LOUPE_FACET_CODEHASH =
        0x5ececdca86d9f1fe420092767c7a1c70740e978a4fed181f23d309be460dc518;
    // ERC165Facet
    address internal constant ERC165_FACET_ADDRESS = 0x012f635B44Ba137d151A559ed500aAe2bc91432D;
    bytes32 internal constant ERC165_FACET_CODEHASH =
        0x55c3098887cc28912e2a5f435c4388d72389072a7dc9c9afd2a20cea4c9ed319;
    // GovernedVaultInit
    address internal constant GOVERNED_VAULT_INIT_ADDRESS = 0xD9013E770907d485a69Ba766C1e745F8a14ac6C0;
    bytes32 internal constant GOVERNED_VAULT_INIT_CODEHASH =
        0x0b29f2da5707b8f5e952d7834b0f4e5ecbc29a87b88778fe10db5e923c3d24ef;

    string internal missing;
    string internal wrongCode;

    function run() external returns (address diamond) {
        ChainConfig memory config = _chainConfig();
        _checkSharedContracts(config);

        vm.startBroadcast();
        (, address deployer,) = vm.readCallers();
        bytes32 salt = _salt(deployer);
        address predicted = _predict(config, deployer, salt);
        if (predicted.code.length != 0) revert AddressTaken(predicted);
        (address init, bytes memory initCalldata) = _init();
        RecipeEntry[] memory entries = new RecipeEntry[](0);
        diamond = ILatticeFactory(config.factory).deploy(entries, _cuts(), init, initCalldata, salt);
        vm.stopBroadcast();

        if (diamond != predicted) revert PredictionDiffers(predicted, diamond);
        _checkFacets(diamond);
        console.log("Deployed", PROJECT, "at", diamond);
        console.log("Recipe hash", vm.toString(RECIPE_HASH));
        console.log("Verify it from a Lattice checkout at commit", config.proxyCommit);
        console.log(
            string.concat(
                "FOUNDRY_PROFILE=ci forge verify-contract ",
                vm.toString(diamond),
                " src/Lattice.sol:Lattice --verifier sourcify --chain ",
                vm.toString(block.chainid)
            )
        );
    }

    function _chainConfig() internal view returns (ChainConfig memory config) {
        if (block.chainid == 84532) {
            config.factory = 0xc0eac9A5c061341447c7ffbdcAbF9aFc4A832326;
            config.factoryCodehash = 0xe2c27a322dc567b6cf13836027251994d3ce09185317ece7930a43d35313bc35;
            config.proxyInitCodeHash = 0x7cc787ff8e5606b9dcb9ff1b63e5e58570447e5a8d856c51cfa91cd4642001d0;
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        if (block.chainid == 11155111) {
            config.factory = 0xc0eac9A5c061341447c7ffbdcAbF9aFc4A832326;
            config.factoryCodehash = 0xe2c27a322dc567b6cf13836027251994d3ce09185317ece7930a43d35313bc35;
            config.proxyInitCodeHash = 0x7cc787ff8e5606b9dcb9ff1b63e5e58570447e5a8d856c51cfa91cd4642001d0;
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        revert UnsupportedChain(block.chainid, SUPPORTED_CHAINS);
    }

    function _checkSharedContracts(ChainConfig memory config) internal {
        _expect("LatticeFactory", config.factory, config.factoryCodehash);
        _expect("ERC20", ERC20_ADDRESS, ERC20_CODEHASH);
        _expect("ERC20Votes", ERC20_VOTES_ADDRESS, ERC20_VOTES_CODEHASH);
        _expect("ERC4626", ERC4626_ADDRESS, ERC4626_CODEHASH);
        _expect("GovernedVault", GOVERNED_VAULT_ADDRESS, GOVERNED_VAULT_CODEHASH);
        _expect("VaultCore", VAULT_CORE_ADDRESS, VAULT_CORE_CODEHASH);
        _expect("GovernedDiamondCut", GOVERNED_DIAMOND_CUT_ADDRESS, GOVERNED_DIAMOND_CUT_CODEHASH);
        _expect("Governor", GOVERNOR_ADDRESS, GOVERNOR_CODEHASH);
        _expect("TimelockController", TIMELOCK_CONTROLLER_ADDRESS, TIMELOCK_CONTROLLER_CODEHASH);
        _expect("Votes", VOTES_ADDRESS, VOTES_CODEHASH);
        _expect("EmergencyStop", EMERGENCY_STOP_ADDRESS, EMERGENCY_STOP_CODEHASH);
        _expect("AccessControl", ACCESS_CONTROL_ADDRESS, ACCESS_CONTROL_CODEHASH);
        _expect("Receive", RECEIVE_ADDRESS, RECEIVE_CODEHASH);
        _expect("DiamondLoupeFacet", DIAMOND_LOUPE_FACET_ADDRESS, DIAMOND_LOUPE_FACET_CODEHASH);
        _expect("ERC165Facet", ERC165_FACET_ADDRESS, ERC165_FACET_CODEHASH);
        _expect("GovernedVaultInit", GOVERNED_VAULT_INIT_ADDRESS, GOVERNED_VAULT_INIT_CODEHASH);
        if (bytes(wrongCode).length != 0) revert UnexpectedCode(wrongCode);
        if (bytes(missing).length != 0) revert MissingSharedContracts(missing, MISSING_HELP);
    }

    function _expect(string memory name, address target, bytes32 codehash) internal {
        if (target.code.length == 0) {
            missing = _join(missing, name);
        } else if (target.codehash != codehash) {
            wrongCode = _join(wrongCode, string.concat(name, " at ", vm.toString(target)));
        }
    }

    function _join(string memory list, string memory item) internal pure returns (string memory) {
        return bytes(list).length == 0 ? item : string.concat(list, ", ", item);
    }

    // from ‖ scope ‖ entropy: 20 + 1 + 11 bytes, the salt Lattice Studio builds for the deploying account.
    function _salt(address deployer) internal pure returns (bytes32) {
        return bytes32(bytes20(deployer)) | (bytes32(SCOPE) >> 160) | (bytes32(ENTROPY) >> 168);
    }

    // CREATE2 from the factory with keccak256(abi.encode(deployer, salt)), as LatticeFactory._saltFor folds it.
    function _predict(ChainConfig memory config, address deployer, bytes32 salt) internal view returns (address) {
        bytes32 folded = keccak256(abi.encode(deployer, salt));
        bytes32 digest = keccak256(abi.encodePacked(bytes1(0xff), config.factory, folded, config.proxyInitCodeHash));
        address predicted = address(uint160(uint256(digest)));
        address reported = ILatticeFactory(config.factory).predict(deployer, salt);
        if (reported != predicted) revert PredictionDiffers(predicted, reported);
        return predicted;
    }

    // facets() against the plan, per facet as sets: LatticeFactory applies registry cuts first, so order differs.
    function _checkFacets(address diamond) internal view {
        FacetCut[] memory cuts = _cuts();
        Facet[] memory facets = IDiamondLoupe(diamond).facets();
        if (facets.length != cuts.length) revert FacetsDiffer(cuts.length, facets.length);
        for (uint256 i; i < facets.length; ++i) {
            bytes4[] memory expected = _selectorsOf(cuts, facets[i].facetAddress);
            bytes4[] memory actual = facets[i].functionSelectors;
            if (expected.length != actual.length) revert SelectorsDiffer(facets[i].facetAddress);
            for (uint256 j; j < actual.length; ++j) {
                if (!_contains(expected, actual[j])) revert SelectorsDiffer(facets[i].facetAddress);
            }
        }
    }

    function _selectorsOf(FacetCut[] memory cuts, address facet) internal pure returns (bytes4[] memory) {
        for (uint256 i; i < cuts.length; ++i) {
            if (cuts[i].facetAddress == facet) return cuts[i].functionSelectors;
        }
        revert UnexpectedFacet(facet);
    }

    function _contains(bytes4[] memory list, bytes4 selector) internal pure returns (bool) {
        for (uint256 i; i < list.length; ++i) {
            if (list[i] == selector) return true;
        }
        return false;
    }

    function _cuts() internal pure returns (FacetCut[] memory cuts) {
        cuts = new FacetCut[](14);
        bytes4[] memory selectors;

        // ERC20 0.2.0
        selectors = new bytes4[](5);
        selectors[0] = bytes4(0xdd62ed3e); // allowance(address,address)
        selectors[1] = bytes4(0x095ea7b3); // approve(address,uint256)
        selectors[2] = bytes4(0x70a08231); // balanceOf(address)
        selectors[3] = bytes4(0x95d89b41); // symbol()
        selectors[4] = bytes4(0x18160ddd); // totalSupply()
        cuts[0] = FacetCut(ERC20_ADDRESS, FacetCutAction.Add, selectors);

        // ERC20Votes 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0xf1127ed8); // checkpoints(address,uint32)
        selectors[1] = bytes4(0x5c19a95c); // delegate(address)
        selectors[2] = bytes4(0xc3cda520); // delegateBySig(address,uint256,uint256,uint8,bytes32,bytes32)
        selectors[3] = bytes4(0x6fcfff45); // numCheckpoints(address)
        cuts[1] = FacetCut(ERC20_VOTES_ADDRESS, FacetCutAction.Add, selectors);

        // ERC4626 0.2.0
        selectors = new bytes4[](12);
        selectors[0] = bytes4(0x38d52e0f); // asset()
        selectors[1] = bytes4(0x07a2d13a); // convertToAssets(uint256)
        selectors[2] = bytes4(0xc6e6f592); // convertToShares(uint256)
        selectors[3] = bytes4(0x313ce567); // decimals()
        selectors[4] = bytes4(0x402d267d); // maxDeposit(address)
        selectors[5] = bytes4(0xc63d75b6); // maxMint(address)
        selectors[6] = bytes4(0xd905777e); // maxRedeem(address)
        selectors[7] = bytes4(0xce96cb77); // maxWithdraw(address)
        selectors[8] = bytes4(0xef8b30f7); // previewDeposit(uint256)
        selectors[9] = bytes4(0xb3d7f6b9); // previewMint(uint256)
        selectors[10] = bytes4(0x4cdad506); // previewRedeem(uint256)
        selectors[11] = bytes4(0x0a28a477); // previewWithdraw(uint256)
        cuts[2] = FacetCut(ERC4626_ADDRESS, FacetCutAction.Add, selectors);

        // GovernedVault 0.2.0
        selectors = new bytes4[](11);
        selectors[0] = bytes4(0x4bf5d7e9); // CLOCK_MODE()
        selectors[1] = bytes4(0xd5cae628); // ballotNonce(address)
        selectors[2] = bytes4(0x8ff262e3); // castVoteBySig(uint256,uint8,address,bytes)
        selectors[3] = bytes4(0x91ddadf4); // clock()
        selectors[4] = bytes4(0x6e553f65); // deposit(uint256,address)
        selectors[5] = bytes4(0x94bf804d); // mint(uint256,address)
        selectors[6] = bytes4(0x06fdde03); // name()
        selectors[7] = bytes4(0xba087652); // redeem(uint256,address,address)
        selectors[8] = bytes4(0xa9059cbb); // transfer(address,uint256)
        selectors[9] = bytes4(0x23b872dd); // transferFrom(address,address,uint256)
        selectors[10] = bytes4(0xb460af94); // withdraw(uint256,address,address)
        cuts[3] = FacetCut(GOVERNED_VAULT_ADDRESS, FacetCutAction.Add, selectors);

        // VaultCore 0.2.0
        selectors = new bytes4[](7);
        selectors[0] = bytes4(0x5915e15d); // allocateToStrategy(address,uint256)
        selectors[1] = bytes4(0x36cd2b11); // allocatedAssets()
        selectors[2] = bytes4(0xe16b03a3); // idleAssets()
        selectors[3] = bytes4(0x43ff28f3); // recallFromStrategy(address,uint256)
        selectors[4] = bytes4(0x5c966646); // setStrategyManager(address)
        selectors[5] = bytes4(0x39b70e38); // strategyManager()
        selectors[6] = bytes4(0x01e1d114); // totalAssets()
        cuts[4] = FacetCut(VAULT_CORE_ADDRESS, FacetCutAction.Add, selectors);

        // GovernedDiamondCut 0.2.0
        selectors = new bytes4[](9);
        selectors[0] = bytes4(0xaa982c45); // cutCount()
        selectors[1] = bytes4(0x1f931c1c); // diamondCut((address,uint8,bytes4[])[],address,bytes)
        selectors[2] = bytes4(0xc83542a6); // emergencyRemoveCut((address,uint8,bytes4[])[])
        selectors[3] = bytes4(0x4487678f); // freezeSelectors(bytes4[])
        selectors[4] = bytes4(0x22cabf70); // frozenSelectors()
        selectors[5] = bytes4(0x3adda78e); // getCutRecord(uint256)
        selectors[6] = bytes4(0xc8d8e114); // isSelectorFrozen(bytes4)
        selectors[7] = bytes4(0x35342750); // previewCut((address,uint8,bytes4[])[])
        selectors[8] = bytes4(0x0746a956); // verifyInterfaceRegistered(bytes4)
        cuts[5] = FacetCut(GOVERNED_DIAMOND_CUT_ADDRESS, FacetCutAction.Add, selectors);

        // Governor 0.2.0
        selectors = new bytes4[](32);
        selectors[0] = bytes4(0xdd4e2ba5); // COUNTING_MODE()
        selectors[1] = bytes4(0x452115d6); // cancel(address[],uint256[],bytes[],bytes32)
        selectors[2] = bytes4(0x56781388); // castVote(uint256,uint8)
        selectors[3] = bytes4(0x7b3c71d3); // castVoteWithReason(uint256,uint8,string)
        selectors[4] = bytes4(0x5f398a14); // castVoteWithReasonAndParams(uint256,uint8,string,bytes)
        selectors[5] = bytes4(0x2656227d); // execute(address[],uint256[],bytes[],bytes32)
        selectors[6] = bytes4(0xeb9019d4); // getVotes(address,uint256)
        selectors[7] = bytes4(0x43859632); // hasVoted(uint256,address)
        selectors[8] = bytes4(0xc59057e4); // hashProposal(address[],uint256[],bytes[],bytes32)
        selectors[9] = bytes4(0xc01f9e37); // proposalDeadline(uint256)
        selectors[10] = bytes4(0xab58fb8e); // proposalEta(uint256)
        selectors[11] = bytes4(0x143489d0); // proposalProposer(uint256)
        selectors[12] = bytes4(0x2d63f693); // proposalSnapshot(uint256)
        selectors[13] = bytes4(0xb58131b0); // proposalThreshold()
        selectors[14] = bytes4(0x544ffc9c); // proposalVotes(uint256)
        selectors[15] = bytes4(0x7d5e81e2); // propose(address[],uint256[],bytes[],string)
        selectors[16] = bytes4(0x160cbed7); // queue(address[],uint256[],bytes[],bytes32)
        selectors[17] = bytes4(0xf8ce560a); // quorum(uint256)
        selectors[18] = bytes4(0x97c3d334); // quorumDenominator()
        selectors[19] = bytes4(0xa7713a70); // quorumNumerator()
        selectors[20] = bytes4(0x60c4247f); // quorumNumerator(uint256)
        selectors[21] = bytes4(0xece40cc1); // setProposalThreshold(uint256)
        selectors[22] = bytes4(0x79051887); // setVotingDelay(uint48)
        selectors[23] = bytes4(0xe540d01d); // setVotingPeriod(uint32)
        selectors[24] = bytes4(0x3e4f49e6); // state(uint256)
        selectors[25] = bytes4(0xd33219b4); // timelock()
        selectors[26] = bytes4(0xfc0c546a); // token()
        selectors[27] = bytes4(0x06f3f9e6); // updateQuorumNumerator(uint256)
        selectors[28] = bytes4(0xa890c910); // updateTimelock(address)
        selectors[29] = bytes4(0x54fd4d50); // version()
        selectors[30] = bytes4(0x3932abb1); // votingDelay()
        selectors[31] = bytes4(0x02a251a3); // votingPeriod()
        cuts[6] = FacetCut(GOVERNOR_ADDRESS, FacetCutAction.Add, selectors);

        // TimelockController 0.2.0
        selectors = new bytes4[](18);
        selectors[0] = bytes4(0xb08e51c0); // CANCELLER_ROLE()
        selectors[1] = bytes4(0x07bd0265); // EXECUTOR_ROLE()
        selectors[2] = bytes4(0x8f61f4f5); // PROPOSER_ROLE()
        selectors[3] = bytes4(0xc4d252f5); // cancel(bytes32)
        selectors[4] = bytes4(0x134008d3); // execute(address,uint256,bytes,bytes32,bytes32)
        selectors[5] = bytes4(0xe38335e5); // executeBatch(address[],uint256[],bytes[],bytes32,bytes32)
        selectors[6] = bytes4(0xf27a0c92); // getMinDelay()
        selectors[7] = bytes4(0x7958004c); // getOperationState(bytes32)
        selectors[8] = bytes4(0xd45c4435); // getTimestamp(bytes32)
        selectors[9] = bytes4(0x8065657f); // hashOperation(address,uint256,bytes,bytes32,bytes32)
        selectors[10] = bytes4(0xb1c5f427); // hashOperationBatch(address[],uint256[],bytes[],bytes32,bytes32)
        selectors[11] = bytes4(0x31d50750); // isOperation(bytes32)
        selectors[12] = bytes4(0x2ab0f529); // isOperationDone(bytes32)
        selectors[13] = bytes4(0x584b153e); // isOperationPending(bytes32)
        selectors[14] = bytes4(0x13bc9f20); // isOperationReady(bytes32)
        selectors[15] = bytes4(0x01d5062a); // schedule(address,uint256,bytes,bytes32,bytes32,uint256)
        selectors[16] = bytes4(0x8f2a0bb0); // scheduleBatch(address[],uint256[],bytes[],bytes32,bytes32,uint256)
        selectors[17] = bytes4(0x64d62353); // updateDelay(uint256)
        cuts[7] = FacetCut(TIMELOCK_CONTROLLER_ADDRESS, FacetCutAction.Add, selectors);

        // Votes 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0x587cde1e); // delegates(address)
        selectors[1] = bytes4(0x8e539e8c); // getPastTotalSupply(uint256)
        selectors[2] = bytes4(0x3a46b1a8); // getPastVotes(address,uint256)
        selectors[3] = bytes4(0x9ab24eb0); // getVotes(address)
        cuts[8] = FacetCut(VOTES_ADDRESS, FacetCutAction.Add, selectors);

        // EmergencyStop 0.2.0
        selectors = new bytes4[](7);
        selectors[0] = bytes4(0xa526d83b); // addGuardian(address)
        selectors[1] = bytes4(0x93c87f03); // emergencyResume()
        selectors[2] = bytes4(0xb1e3268b); // emergencyStop(string)
        selectors[3] = bytes4(0x0c68ba21); // isGuardian(address)
        selectors[4] = bytes4(0x3f683b6a); // isStopped()
        selectors[5] = bytes4(0x71404156); // removeGuardian(address)
        selectors[6] = bytes4(0x5b0b0c07); // stoppedReason()
        cuts[9] = FacetCut(EMERGENCY_STOP_ADDRESS, FacetCutAction.Add, selectors);

        // AccessControl 0.2.0
        selectors = new bytes4[](5);
        selectors[0] = bytes4(0x248a9ca3); // getRoleAdmin(bytes32)
        selectors[1] = bytes4(0x2f2ff15d); // grantRole(bytes32,address)
        selectors[2] = bytes4(0x91d14854); // hasRole(bytes32,address)
        selectors[3] = bytes4(0x36568abe); // renounceRole(bytes32,address)
        selectors[4] = bytes4(0xd547741f); // revokeRole(bytes32,address)
        cuts[10] = FacetCut(ACCESS_CONTROL_ADDRESS, FacetCutAction.Add, selectors);

        // Receive 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x00000000); // receive()
        cuts[11] = FacetCut(RECEIVE_ADDRESS, FacetCutAction.Add, selectors);

        // DiamondLoupeFacet 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0x7a0ed627); // facets()
        selectors[1] = bytes4(0xadfca15e); // facetFunctionSelectors(address)
        selectors[2] = bytes4(0x52ef6b2c); // facetAddresses()
        selectors[3] = bytes4(0xcdffacc6); // facetAddress(bytes4)
        cuts[12] = FacetCut(DIAMOND_LOUPE_FACET_ADDRESS, FacetCutAction.Add, selectors);

        // ERC165Facet 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x01ffc9a7); // supportsInterface(bytes4)
        cuts[13] = FacetCut(ERC165_FACET_ADDRESS, FacetCutAction.Add, selectors);
    }

    function _init() internal pure returns (address target, bytes memory data) {
        target = GOVERNED_VAULT_INIT_ADDRESS;
        data = _initStep0();
    }

    // bundle: GovernedVaultInit.init((address,string,string,uint8,uint256,uint48,uint32,uint256,uint256))
    function _initStep0() internal pure returns (bytes memory data) {
        data = abi.encodeWithSelector(bytes4(0x7ee12e1b), _arg1());
    }

    // bundle.p
    function _arg1() internal pure returns (GovernedVaultInitP memory v) {
        v.asset = 0x71C7656EC7ab88b098defB751B7401B5f6d8976F;
        v.name = "Grant vault";
        v.symbol = "gVLT";
        v.decimalsOffset = uint8(0);
        v.minDelay = uint256(300);
        v.votingDelay = uint48(60);
        v.votingPeriod = uint32(600);
        v.proposalThreshold = uint256(0);
        v.quorumNumerator = uint256(4);
    }
}
"
`;

exports[`exportFoundry snapshot: GovernedVault through createx 1`] = `
"// SPDX-License-Identifier: MIT
// DeployGovernedVault.s.sol: deploys the diamond "GovernedVault" as Lattice Studio composed it.
// Generated by Lattice Studio 0.1.0. The same recipe, catalog and inputs give the same bytes.
//
// Recipe hash: 0xdebb5588007f0eebc5ae92371b5928c6f33cf04998c3d415d4502db9861b909b
// Catalog: Lattice fixture at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79, catalog hash 0xce843be12f8b470d72cd0ddb41df9aed8a0c7d7abad718b34bb8b2731805ff24
// Provisional: Lattice 0.2.0 at dev f4a32c8; v1 targets 0.4.0. Fixture catalog: invented release data.
// Toolchain: Foundry 1.8.3, solc 0.8.36
// Deploys through: CreateX.deployCreate3AndInit, one transaction with its init
// Salt: deploying account, scope 0x01 (this-chain), entropy 0x0000000000000000000001
// Chains: 84532, 11155111
//
// Run:
//   forge script DeployGovernedVault.s.sol --rpc-url $RPC_URL --account deployer --broadcast
// On Anvil, fork a supported chain where the shared contracts exist: anvil --fork-url $RPC_URL
//
// Before it broadcasts, the script checks that every shared contract's codehash matches the catalog, that the
// predicted address is empty, and that its own simulation of the deploy finds facets() equal to this plan:
//   ERC20 0.2.0, 5 selectors
//   ERC20Votes 0.2.0, 4 selectors
//   ERC4626 0.2.0, 12 selectors
//   GovernedVault 0.2.0, 11 selectors
//   VaultCore 0.2.0, 7 selectors
//   GovernedDiamondCut 0.2.0, 9 selectors
//   Governor 0.2.0, 32 selectors
//   TimelockController 0.2.0, 18 selectors
//   Votes 0.2.0, 4 selectors
//   EmergencyStop 0.2.0, 7 selectors
//   AccessControl 0.2.0, 5 selectors
//   Receive 0.2.0, 1 selector
//   DiamondLoupeFacet 0.2.0, 4 selectors
//   ERC165Facet 0.2.0, 1 selector
//
// Init: one direct call
//   GovernedVaultInit.init((address,string,string,uint8,uint256,uint48,uint32,uint256,uint256))
// References: "This diamond" is the predicted address; "Deploying account" is the broadcaster.
//
// Verify: the script creates no contract forge could match. Verify the diamond against the published Lattice
// standard JSON, in a Lattice checkout at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79:
//   FOUNDRY_PROFILE=ci forge verify-contract <diamond> src/Lattice.sol:Lattice --verifier sourcify --chain <chain id>
//
// Leaves out:
//   Deploying missing shared contracts: use Deploy missing contracts… in Lattice Studio or the lattice-studio CLI.
pragma solidity ^0.8.30;

import {Script} from "forge-std/Script.sol";
import {console} from "forge-std/console.sol";

// Lattice's diamond types (diamond-lib DiamondLib.sol and ILatticeFactory.sol at the pin), inlined.
enum FacetCutAction {
    Add,
    Replace,
    Remove
}

struct FacetCut {
    address facetAddress;
    FacetCutAction action;
    bytes4[] functionSelectors;
}

struct Facet {
    address facetAddress;
    bytes4[] functionSelectors;
}

interface ICreateX {
    struct Values {
        uint256 constructorAmount;
        uint256 initCallAmount;
    }

    function deployCreate3AndInit(bytes32 salt, bytes memory initCode, bytes memory data, Values memory values)
        external
        payable
        returns (address newContract);

    function computeCreate3Address(bytes32 salt) external view returns (address computedAddress);
}

interface ILattice {
    function initialize(FacetCut[] calldata facetCuts, address init, bytes calldata data) external payable;
}

interface IDiamondLoupe {
    function facets() external view returns (Facet[] memory);
}

struct ChainConfig {
    string proxyCommit;
}

// GovernedVaultInit p: address asset, string name, string symbol, uint8 decimalsOffset, uint256 minDelay, uint48 votingDelay, uint32 votingPeriod, uint256 proposalThreshold, uint256 quorumNumerator
struct GovernedVaultInitP {
    address asset;
    string name;
    string symbol;
    uint8 decimalsOffset;
    uint256 minDelay;
    uint48 votingDelay;
    uint32 votingPeriod;
    uint256 proposalThreshold;
    uint256 quorumNumerator;
}

contract DeployGovernedVault is Script {
    error UnsupportedChain(uint256 chainId, string supportedChains);
    error MissingSharedContracts(string names, string howToDeploy);
    error UnexpectedCode(string contracts);
    error AddressTaken(address predicted);
    error PredictionDiffers(address expected, address actual);
    error FacetsDiffer(uint256 expected, uint256 actual);
    error UnexpectedFacet(address facet);
    error SelectorsDiffer(address facet);

    string internal constant PROJECT = "GovernedVault";
    bytes32 internal constant RECIPE_HASH = 0xdebb5588007f0eebc5ae92371b5928c6f33cf04998c3d415d4502db9861b909b;
    bytes1 internal constant SCOPE = 0x01;
    bytes11 internal constant ENTROPY = 0x0000000000000000000001;
    string internal constant SUPPORTED_CHAINS = "84532, 11155111";
    string internal constant MISSING_HELP =
        "Deploy them first with Deploy missing contracts\\u2026 in Lattice Studio or with the lattice-studio CLI.";
    address internal constant CREATEX = 0xba5Ed099633D3B313e4D5F7bdc1305d3c28ba5Ed;
    bytes32 internal constant CREATE3_PROXY_CHILD_HASH =
        0x21c35dbe1b344a2488cf3321d6ce542f8e9f305544ff09e4993a62319a497c1f;
    bytes internal constant LATTICE_CREATION_CODE = hex"666978747572653a4c617474696365";

    // Shared contracts, at the addresses and codehashes the catalog pins.
    // ERC20
    address internal constant ERC20_ADDRESS = 0xcEA19e568b017a5DBc2FFBbEc9E37d1b874dF808;
    bytes32 internal constant ERC20_CODEHASH = 0xb2bdd94e24a77f078ecc3d7063e3fb7887a9f398749728cfa17039ff2eddc429;
    // ERC20Votes
    address internal constant ERC20_VOTES_ADDRESS = 0x73f7D19a7722e012E7D3f85DdD214623DE3307c0;
    bytes32 internal constant ERC20_VOTES_CODEHASH = 0x0906f0cc6eadea1f122cd52669dd45f10a3f62436b3fb4351718e5cf67e41396;
    // ERC4626
    address internal constant ERC4626_ADDRESS = 0x920000407eC61a764eb42d336B6aE7504aD96eca;
    bytes32 internal constant ERC4626_CODEHASH = 0x793facbb53d32f1c76ee298b357e54060e9beed4f0791ccbe5edf4ae83e3c26e;
    // GovernedVault
    address internal constant GOVERNED_VAULT_ADDRESS = 0xc6B9Fa301ebA3F1900C636C4f2F79838A1eA80b0;
    bytes32 internal constant GOVERNED_VAULT_CODEHASH =
        0x59a69f7bc0d053900e2ad8887481252f23292315ea86b1446fdef8498f9f1a64;
    // VaultCore
    address internal constant VAULT_CORE_ADDRESS = 0xA278F94902FF5f426436DF7b6621c6c15Cd9798d;
    bytes32 internal constant VAULT_CORE_CODEHASH = 0xb89a2f252dadfd7c0193648e7ebd47d59f542e150b885b7f5c9aa9ecf9e99b53;
    // GovernedDiamondCut
    address internal constant GOVERNED_DIAMOND_CUT_ADDRESS = 0x830D554C069662C55987899D641BdE496c31cDe6;
    bytes32 internal constant GOVERNED_DIAMOND_CUT_CODEHASH =
        0x8f8aa27c654743cf0f3d2de6533eebb2b54a419438494038d96786e7e8ddbc5b;
    // Governor
    address internal constant GOVERNOR_ADDRESS = 0x1A24D23c095E898bEa3abe332dD0788b6A8C0B32;
    bytes32 internal constant GOVERNOR_CODEHASH = 0x48519f73e4631681be03edbc1053d0a6436d342853bb273f85cf4e94c905ed17;
    // TimelockController
    address internal constant TIMELOCK_CONTROLLER_ADDRESS = 0x2BADa24222FB6290fAF96D0f66127A9df12dcee1;
    bytes32 internal constant TIMELOCK_CONTROLLER_CODEHASH =
        0xd971b3fec36e27b456229fb3987d982951814ba7ab5f218c02e206ec5c0d16e7;
    // Votes
    address internal constant VOTES_ADDRESS = 0x9703372cF4AeC92836aB60E4845136dFdf71dD1c;
    bytes32 internal constant VOTES_CODEHASH = 0xdd81f2bfbedaa2eabfa89ceaef8551f7cc3c22f6ce70a688d21fcf6c594d5c7e;
    // EmergencyStop
    address internal constant EMERGENCY_STOP_ADDRESS = 0x0Af4CDFAA22B63C9731652A8Cd603e14f89d07F1;
    bytes32 internal constant EMERGENCY_STOP_CODEHASH =
        0xf280916d758b8ac4a20583c038740275d341dffa4cb55dbf653cfb9400090eef;
    // AccessControl
    address internal constant ACCESS_CONTROL_ADDRESS = 0xC31C375CD6003764be3C0F049587De2a15247fF1;
    bytes32 internal constant ACCESS_CONTROL_CODEHASH =
        0x609e15ee4618e038bb5734dae08499fb76f5cf58cd9b7d1f71abdcc79e9e4b87;
    // Receive
    address internal constant RECEIVE_ADDRESS = 0x96E186Fea88E3cCe88ea390CDEEC846a78606812;
    bytes32 internal constant RECEIVE_CODEHASH = 0x618c1fd98e5806c5b441229b919c384b9846d05410bb885eb04dd0a2d0daa7ab;
    // DiamondLoupeFacet
    address internal constant DIAMOND_LOUPE_FACET_ADDRESS = 0x1398f1E9e9aCD915570Ac58AE98160Abc625325F;
    bytes32 internal constant DIAMOND_LOUPE_FACET_CODEHASH =
        0x5ececdca86d9f1fe420092767c7a1c70740e978a4fed181f23d309be460dc518;
    // ERC165Facet
    address internal constant ERC165_FACET_ADDRESS = 0x012f635B44Ba137d151A559ed500aAe2bc91432D;
    bytes32 internal constant ERC165_FACET_CODEHASH =
        0x55c3098887cc28912e2a5f435c4388d72389072a7dc9c9afd2a20cea4c9ed319;
    // GovernedVaultInit
    address internal constant GOVERNED_VAULT_INIT_ADDRESS = 0xD9013E770907d485a69Ba766C1e745F8a14ac6C0;
    bytes32 internal constant GOVERNED_VAULT_INIT_CODEHASH =
        0x0b29f2da5707b8f5e952d7834b0f4e5ecbc29a87b88778fe10db5e923c3d24ef;

    string internal missing;
    string internal wrongCode;

    function run() external returns (address diamond) {
        ChainConfig memory config = _chainConfig();
        _checkSharedContracts(config);

        vm.startBroadcast();
        (, address deployer,) = vm.readCallers();
        bytes32 salt = _salt(deployer);
        address predicted = _predict(config, deployer, salt);
        if (predicted.code.length != 0) revert AddressTaken(predicted);
        (address init, bytes memory initCalldata) = _init();
        bytes memory initialize = abi.encodeCall(ILattice.initialize, (_cuts(), init, initCalldata));
        ICreateX.Values memory values = ICreateX.Values(0, 0);
        diamond = ICreateX(CREATEX).deployCreate3AndInit(salt, LATTICE_CREATION_CODE, initialize, values);
        vm.stopBroadcast();

        if (diamond != predicted) revert PredictionDiffers(predicted, diamond);
        _checkFacets(diamond);
        console.log("Deployed", PROJECT, "at", diamond);
        console.log("Recipe hash", vm.toString(RECIPE_HASH));
        console.log("Verify it from a Lattice checkout at commit", config.proxyCommit);
        console.log(
            string.concat(
                "FOUNDRY_PROFILE=ci forge verify-contract ",
                vm.toString(diamond),
                " src/Lattice.sol:Lattice --verifier sourcify --chain ",
                vm.toString(block.chainid)
            )
        );
    }

    function _chainConfig() internal view returns (ChainConfig memory config) {
        if (block.chainid == 84532) {
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        if (block.chainid == 11155111) {
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        revert UnsupportedChain(block.chainid, SUPPORTED_CHAINS);
    }

    function _checkSharedContracts(ChainConfig memory) internal {
        if (CREATEX.code.length == 0) missing = "CreateX";
        _expect("ERC20", ERC20_ADDRESS, ERC20_CODEHASH);
        _expect("ERC20Votes", ERC20_VOTES_ADDRESS, ERC20_VOTES_CODEHASH);
        _expect("ERC4626", ERC4626_ADDRESS, ERC4626_CODEHASH);
        _expect("GovernedVault", GOVERNED_VAULT_ADDRESS, GOVERNED_VAULT_CODEHASH);
        _expect("VaultCore", VAULT_CORE_ADDRESS, VAULT_CORE_CODEHASH);
        _expect("GovernedDiamondCut", GOVERNED_DIAMOND_CUT_ADDRESS, GOVERNED_DIAMOND_CUT_CODEHASH);
        _expect("Governor", GOVERNOR_ADDRESS, GOVERNOR_CODEHASH);
        _expect("TimelockController", TIMELOCK_CONTROLLER_ADDRESS, TIMELOCK_CONTROLLER_CODEHASH);
        _expect("Votes", VOTES_ADDRESS, VOTES_CODEHASH);
        _expect("EmergencyStop", EMERGENCY_STOP_ADDRESS, EMERGENCY_STOP_CODEHASH);
        _expect("AccessControl", ACCESS_CONTROL_ADDRESS, ACCESS_CONTROL_CODEHASH);
        _expect("Receive", RECEIVE_ADDRESS, RECEIVE_CODEHASH);
        _expect("DiamondLoupeFacet", DIAMOND_LOUPE_FACET_ADDRESS, DIAMOND_LOUPE_FACET_CODEHASH);
        _expect("ERC165Facet", ERC165_FACET_ADDRESS, ERC165_FACET_CODEHASH);
        _expect("GovernedVaultInit", GOVERNED_VAULT_INIT_ADDRESS, GOVERNED_VAULT_INIT_CODEHASH);
        if (bytes(wrongCode).length != 0) revert UnexpectedCode(wrongCode);
        if (bytes(missing).length != 0) revert MissingSharedContracts(missing, MISSING_HELP);
    }

    function _expect(string memory name, address target, bytes32 codehash) internal {
        if (target.code.length == 0) {
            missing = _join(missing, name);
        } else if (target.codehash != codehash) {
            wrongCode = _join(wrongCode, string.concat(name, " at ", vm.toString(target)));
        }
    }

    function _join(string memory list, string memory item) internal pure returns (string memory) {
        return bytes(list).length == 0 ? item : string.concat(list, ", ", item);
    }

    // from ‖ scope ‖ entropy: 20 + 1 + 11 bytes, the salt Lattice Studio builds for the deploying account.
    function _salt(address deployer) internal pure returns (bytes32) {
        return bytes32(bytes20(deployer)) | (bytes32(SCOPE) >> 160) | (bytes32(ENTROPY) >> 168);
    }

    // CreateX guards a sender-prefixed salt, then CREATE3: a proxy at CREATE2(CreateX, guarded, child hash), then
    // the diamond at that proxy's first CREATE.
    function _predict(ChainConfig memory, address deployer, bytes32 salt) internal view returns (address) {
        bytes32 guarded = SCOPE == bytes1(0x01)
            ? keccak256(abi.encode(deployer, block.chainid, salt))
            : keccak256(abi.encode(deployer, salt));
        bytes32 digest = keccak256(abi.encodePacked(bytes1(0xff), CREATEX, guarded, CREATE3_PROXY_CHILD_HASH));
        address proxy = address(uint160(uint256(digest)));
        address predicted = address(uint160(uint256(keccak256(abi.encodePacked(hex"d694", proxy, hex"01")))));
        address reported = ICreateX(CREATEX).computeCreate3Address(guarded);
        if (reported != predicted) revert PredictionDiffers(predicted, reported);
        return predicted;
    }

    // facets() against the plan, per facet as sets: LatticeFactory applies registry cuts first, so order differs.
    function _checkFacets(address diamond) internal view {
        FacetCut[] memory cuts = _cuts();
        Facet[] memory facets = IDiamondLoupe(diamond).facets();
        if (facets.length != cuts.length) revert FacetsDiffer(cuts.length, facets.length);
        for (uint256 i; i < facets.length; ++i) {
            bytes4[] memory expected = _selectorsOf(cuts, facets[i].facetAddress);
            bytes4[] memory actual = facets[i].functionSelectors;
            if (expected.length != actual.length) revert SelectorsDiffer(facets[i].facetAddress);
            for (uint256 j; j < actual.length; ++j) {
                if (!_contains(expected, actual[j])) revert SelectorsDiffer(facets[i].facetAddress);
            }
        }
    }

    function _selectorsOf(FacetCut[] memory cuts, address facet) internal pure returns (bytes4[] memory) {
        for (uint256 i; i < cuts.length; ++i) {
            if (cuts[i].facetAddress == facet) return cuts[i].functionSelectors;
        }
        revert UnexpectedFacet(facet);
    }

    function _contains(bytes4[] memory list, bytes4 selector) internal pure returns (bool) {
        for (uint256 i; i < list.length; ++i) {
            if (list[i] == selector) return true;
        }
        return false;
    }

    function _cuts() internal pure returns (FacetCut[] memory cuts) {
        cuts = new FacetCut[](14);
        bytes4[] memory selectors;

        // ERC20 0.2.0
        selectors = new bytes4[](5);
        selectors[0] = bytes4(0xdd62ed3e); // allowance(address,address)
        selectors[1] = bytes4(0x095ea7b3); // approve(address,uint256)
        selectors[2] = bytes4(0x70a08231); // balanceOf(address)
        selectors[3] = bytes4(0x95d89b41); // symbol()
        selectors[4] = bytes4(0x18160ddd); // totalSupply()
        cuts[0] = FacetCut(ERC20_ADDRESS, FacetCutAction.Add, selectors);

        // ERC20Votes 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0xf1127ed8); // checkpoints(address,uint32)
        selectors[1] = bytes4(0x5c19a95c); // delegate(address)
        selectors[2] = bytes4(0xc3cda520); // delegateBySig(address,uint256,uint256,uint8,bytes32,bytes32)
        selectors[3] = bytes4(0x6fcfff45); // numCheckpoints(address)
        cuts[1] = FacetCut(ERC20_VOTES_ADDRESS, FacetCutAction.Add, selectors);

        // ERC4626 0.2.0
        selectors = new bytes4[](12);
        selectors[0] = bytes4(0x38d52e0f); // asset()
        selectors[1] = bytes4(0x07a2d13a); // convertToAssets(uint256)
        selectors[2] = bytes4(0xc6e6f592); // convertToShares(uint256)
        selectors[3] = bytes4(0x313ce567); // decimals()
        selectors[4] = bytes4(0x402d267d); // maxDeposit(address)
        selectors[5] = bytes4(0xc63d75b6); // maxMint(address)
        selectors[6] = bytes4(0xd905777e); // maxRedeem(address)
        selectors[7] = bytes4(0xce96cb77); // maxWithdraw(address)
        selectors[8] = bytes4(0xef8b30f7); // previewDeposit(uint256)
        selectors[9] = bytes4(0xb3d7f6b9); // previewMint(uint256)
        selectors[10] = bytes4(0x4cdad506); // previewRedeem(uint256)
        selectors[11] = bytes4(0x0a28a477); // previewWithdraw(uint256)
        cuts[2] = FacetCut(ERC4626_ADDRESS, FacetCutAction.Add, selectors);

        // GovernedVault 0.2.0
        selectors = new bytes4[](11);
        selectors[0] = bytes4(0x4bf5d7e9); // CLOCK_MODE()
        selectors[1] = bytes4(0xd5cae628); // ballotNonce(address)
        selectors[2] = bytes4(0x8ff262e3); // castVoteBySig(uint256,uint8,address,bytes)
        selectors[3] = bytes4(0x91ddadf4); // clock()
        selectors[4] = bytes4(0x6e553f65); // deposit(uint256,address)
        selectors[5] = bytes4(0x94bf804d); // mint(uint256,address)
        selectors[6] = bytes4(0x06fdde03); // name()
        selectors[7] = bytes4(0xba087652); // redeem(uint256,address,address)
        selectors[8] = bytes4(0xa9059cbb); // transfer(address,uint256)
        selectors[9] = bytes4(0x23b872dd); // transferFrom(address,address,uint256)
        selectors[10] = bytes4(0xb460af94); // withdraw(uint256,address,address)
        cuts[3] = FacetCut(GOVERNED_VAULT_ADDRESS, FacetCutAction.Add, selectors);

        // VaultCore 0.2.0
        selectors = new bytes4[](7);
        selectors[0] = bytes4(0x5915e15d); // allocateToStrategy(address,uint256)
        selectors[1] = bytes4(0x36cd2b11); // allocatedAssets()
        selectors[2] = bytes4(0xe16b03a3); // idleAssets()
        selectors[3] = bytes4(0x43ff28f3); // recallFromStrategy(address,uint256)
        selectors[4] = bytes4(0x5c966646); // setStrategyManager(address)
        selectors[5] = bytes4(0x39b70e38); // strategyManager()
        selectors[6] = bytes4(0x01e1d114); // totalAssets()
        cuts[4] = FacetCut(VAULT_CORE_ADDRESS, FacetCutAction.Add, selectors);

        // GovernedDiamondCut 0.2.0
        selectors = new bytes4[](9);
        selectors[0] = bytes4(0xaa982c45); // cutCount()
        selectors[1] = bytes4(0x1f931c1c); // diamondCut((address,uint8,bytes4[])[],address,bytes)
        selectors[2] = bytes4(0xc83542a6); // emergencyRemoveCut((address,uint8,bytes4[])[])
        selectors[3] = bytes4(0x4487678f); // freezeSelectors(bytes4[])
        selectors[4] = bytes4(0x22cabf70); // frozenSelectors()
        selectors[5] = bytes4(0x3adda78e); // getCutRecord(uint256)
        selectors[6] = bytes4(0xc8d8e114); // isSelectorFrozen(bytes4)
        selectors[7] = bytes4(0x35342750); // previewCut((address,uint8,bytes4[])[])
        selectors[8] = bytes4(0x0746a956); // verifyInterfaceRegistered(bytes4)
        cuts[5] = FacetCut(GOVERNED_DIAMOND_CUT_ADDRESS, FacetCutAction.Add, selectors);

        // Governor 0.2.0
        selectors = new bytes4[](32);
        selectors[0] = bytes4(0xdd4e2ba5); // COUNTING_MODE()
        selectors[1] = bytes4(0x452115d6); // cancel(address[],uint256[],bytes[],bytes32)
        selectors[2] = bytes4(0x56781388); // castVote(uint256,uint8)
        selectors[3] = bytes4(0x7b3c71d3); // castVoteWithReason(uint256,uint8,string)
        selectors[4] = bytes4(0x5f398a14); // castVoteWithReasonAndParams(uint256,uint8,string,bytes)
        selectors[5] = bytes4(0x2656227d); // execute(address[],uint256[],bytes[],bytes32)
        selectors[6] = bytes4(0xeb9019d4); // getVotes(address,uint256)
        selectors[7] = bytes4(0x43859632); // hasVoted(uint256,address)
        selectors[8] = bytes4(0xc59057e4); // hashProposal(address[],uint256[],bytes[],bytes32)
        selectors[9] = bytes4(0xc01f9e37); // proposalDeadline(uint256)
        selectors[10] = bytes4(0xab58fb8e); // proposalEta(uint256)
        selectors[11] = bytes4(0x143489d0); // proposalProposer(uint256)
        selectors[12] = bytes4(0x2d63f693); // proposalSnapshot(uint256)
        selectors[13] = bytes4(0xb58131b0); // proposalThreshold()
        selectors[14] = bytes4(0x544ffc9c); // proposalVotes(uint256)
        selectors[15] = bytes4(0x7d5e81e2); // propose(address[],uint256[],bytes[],string)
        selectors[16] = bytes4(0x160cbed7); // queue(address[],uint256[],bytes[],bytes32)
        selectors[17] = bytes4(0xf8ce560a); // quorum(uint256)
        selectors[18] = bytes4(0x97c3d334); // quorumDenominator()
        selectors[19] = bytes4(0xa7713a70); // quorumNumerator()
        selectors[20] = bytes4(0x60c4247f); // quorumNumerator(uint256)
        selectors[21] = bytes4(0xece40cc1); // setProposalThreshold(uint256)
        selectors[22] = bytes4(0x79051887); // setVotingDelay(uint48)
        selectors[23] = bytes4(0xe540d01d); // setVotingPeriod(uint32)
        selectors[24] = bytes4(0x3e4f49e6); // state(uint256)
        selectors[25] = bytes4(0xd33219b4); // timelock()
        selectors[26] = bytes4(0xfc0c546a); // token()
        selectors[27] = bytes4(0x06f3f9e6); // updateQuorumNumerator(uint256)
        selectors[28] = bytes4(0xa890c910); // updateTimelock(address)
        selectors[29] = bytes4(0x54fd4d50); // version()
        selectors[30] = bytes4(0x3932abb1); // votingDelay()
        selectors[31] = bytes4(0x02a251a3); // votingPeriod()
        cuts[6] = FacetCut(GOVERNOR_ADDRESS, FacetCutAction.Add, selectors);

        // TimelockController 0.2.0
        selectors = new bytes4[](18);
        selectors[0] = bytes4(0xb08e51c0); // CANCELLER_ROLE()
        selectors[1] = bytes4(0x07bd0265); // EXECUTOR_ROLE()
        selectors[2] = bytes4(0x8f61f4f5); // PROPOSER_ROLE()
        selectors[3] = bytes4(0xc4d252f5); // cancel(bytes32)
        selectors[4] = bytes4(0x134008d3); // execute(address,uint256,bytes,bytes32,bytes32)
        selectors[5] = bytes4(0xe38335e5); // executeBatch(address[],uint256[],bytes[],bytes32,bytes32)
        selectors[6] = bytes4(0xf27a0c92); // getMinDelay()
        selectors[7] = bytes4(0x7958004c); // getOperationState(bytes32)
        selectors[8] = bytes4(0xd45c4435); // getTimestamp(bytes32)
        selectors[9] = bytes4(0x8065657f); // hashOperation(address,uint256,bytes,bytes32,bytes32)
        selectors[10] = bytes4(0xb1c5f427); // hashOperationBatch(address[],uint256[],bytes[],bytes32,bytes32)
        selectors[11] = bytes4(0x31d50750); // isOperation(bytes32)
        selectors[12] = bytes4(0x2ab0f529); // isOperationDone(bytes32)
        selectors[13] = bytes4(0x584b153e); // isOperationPending(bytes32)
        selectors[14] = bytes4(0x13bc9f20); // isOperationReady(bytes32)
        selectors[15] = bytes4(0x01d5062a); // schedule(address,uint256,bytes,bytes32,bytes32,uint256)
        selectors[16] = bytes4(0x8f2a0bb0); // scheduleBatch(address[],uint256[],bytes[],bytes32,bytes32,uint256)
        selectors[17] = bytes4(0x64d62353); // updateDelay(uint256)
        cuts[7] = FacetCut(TIMELOCK_CONTROLLER_ADDRESS, FacetCutAction.Add, selectors);

        // Votes 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0x587cde1e); // delegates(address)
        selectors[1] = bytes4(0x8e539e8c); // getPastTotalSupply(uint256)
        selectors[2] = bytes4(0x3a46b1a8); // getPastVotes(address,uint256)
        selectors[3] = bytes4(0x9ab24eb0); // getVotes(address)
        cuts[8] = FacetCut(VOTES_ADDRESS, FacetCutAction.Add, selectors);

        // EmergencyStop 0.2.0
        selectors = new bytes4[](7);
        selectors[0] = bytes4(0xa526d83b); // addGuardian(address)
        selectors[1] = bytes4(0x93c87f03); // emergencyResume()
        selectors[2] = bytes4(0xb1e3268b); // emergencyStop(string)
        selectors[3] = bytes4(0x0c68ba21); // isGuardian(address)
        selectors[4] = bytes4(0x3f683b6a); // isStopped()
        selectors[5] = bytes4(0x71404156); // removeGuardian(address)
        selectors[6] = bytes4(0x5b0b0c07); // stoppedReason()
        cuts[9] = FacetCut(EMERGENCY_STOP_ADDRESS, FacetCutAction.Add, selectors);

        // AccessControl 0.2.0
        selectors = new bytes4[](5);
        selectors[0] = bytes4(0x248a9ca3); // getRoleAdmin(bytes32)
        selectors[1] = bytes4(0x2f2ff15d); // grantRole(bytes32,address)
        selectors[2] = bytes4(0x91d14854); // hasRole(bytes32,address)
        selectors[3] = bytes4(0x36568abe); // renounceRole(bytes32,address)
        selectors[4] = bytes4(0xd547741f); // revokeRole(bytes32,address)
        cuts[10] = FacetCut(ACCESS_CONTROL_ADDRESS, FacetCutAction.Add, selectors);

        // Receive 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x00000000); // receive()
        cuts[11] = FacetCut(RECEIVE_ADDRESS, FacetCutAction.Add, selectors);

        // DiamondLoupeFacet 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0x7a0ed627); // facets()
        selectors[1] = bytes4(0xadfca15e); // facetFunctionSelectors(address)
        selectors[2] = bytes4(0x52ef6b2c); // facetAddresses()
        selectors[3] = bytes4(0xcdffacc6); // facetAddress(bytes4)
        cuts[12] = FacetCut(DIAMOND_LOUPE_FACET_ADDRESS, FacetCutAction.Add, selectors);

        // ERC165Facet 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x01ffc9a7); // supportsInterface(bytes4)
        cuts[13] = FacetCut(ERC165_FACET_ADDRESS, FacetCutAction.Add, selectors);
    }

    function _init() internal pure returns (address target, bytes memory data) {
        target = GOVERNED_VAULT_INIT_ADDRESS;
        data = _initStep0();
    }

    // bundle: GovernedVaultInit.init((address,string,string,uint8,uint256,uint48,uint32,uint256,uint256))
    function _initStep0() internal pure returns (bytes memory data) {
        data = abi.encodeWithSelector(bytes4(0x7ee12e1b), _arg1());
    }

    // bundle.p
    function _arg1() internal pure returns (GovernedVaultInitP memory v) {
        v.asset = 0x71C7656EC7ab88b098defB751B7401B5f6d8976F;
        v.name = "Grant vault";
        v.symbol = "gVLT";
        v.decimalsOffset = uint8(0);
        v.minDelay = uint256(300);
        v.votingDelay = uint48(60);
        v.votingPeriod = uint32(600);
        v.proposalThreshold = uint256(0);
        v.quorumNumerator = uint256(4);
    }
}
"
`;

exports[`exportFoundry snapshot: ERC20 through factory 1`] = `
"// SPDX-License-Identifier: MIT
// DeployERC20.s.sol: deploys the diamond "ERC20" as Lattice Studio composed it.
// Generated by Lattice Studio 0.1.0. The same recipe, catalog and inputs give the same bytes.
//
// Recipe hash: 0x359013116635a68e6fa13ab37e7882446a0a1e7afc8d7ce5adbac2a66181cab0
// Catalog: Lattice fixture at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79, catalog hash 0xce843be12f8b470d72cd0ddb41df9aed8a0c7d7abad718b34bb8b2731805ff24
// Provisional: Lattice 0.2.0 at dev f4a32c8; v1 targets 0.4.0. Fixture catalog: invented release data.
// Toolchain: Foundry 1.8.3, solc 0.8.36
// Deploys through: LatticeFactory.deploy, one transaction with its init
// Salt: deploying account, scope 0x00 (every-chain), entropy 0x0000000000000000000001
// Chains: 84532, 11155111
//
// Run:
//   forge script DeployERC20.s.sol --rpc-url $RPC_URL --account deployer --broadcast
// On Anvil, fork a supported chain where the shared contracts exist: anvil --fork-url $RPC_URL
//
// Before it broadcasts, the script checks that every shared contract's codehash matches the catalog, that the
// predicted address is empty, and that its own simulation of the deploy finds facets() equal to this plan:
//   ERC20 0.2.0, 9 selectors
//   Receive 0.2.0, 1 selector
//   DiamondLoupeFacet 0.2.0, 4 selectors
//   ERC165Facet 0.2.0, 1 selector
//
// Init: 2 calls through MultiInit
//   ERC20Init.init(string,string)
//   DiamondIntrospectionInit.initImmutable()
// References: "This diamond" is the predicted address; "Deploying account" is the broadcaster.
//
// Verify: the script creates no contract forge could match. Verify the diamond against the published Lattice
// standard JSON, in a Lattice checkout at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79:
//   FOUNDRY_PROFILE=ci forge verify-contract <diamond> src/Lattice.sol:Lattice --verifier sourcify --chain <chain id>
//
// Leaves out:
//   Deploying missing shared contracts: use Deploy missing contracts… in Lattice Studio or the lattice-studio CLI.
pragma solidity ^0.8.30;

import {Script} from "forge-std/Script.sol";
import {console} from "forge-std/console.sol";

// Lattice's diamond types (diamond-lib DiamondLib.sol and ILatticeFactory.sol at the pin), inlined.
enum FacetCutAction {
    Add,
    Replace,
    Remove
}

struct FacetCut {
    address facetAddress;
    FacetCutAction action;
    bytes4[] functionSelectors;
}

struct Facet {
    address facetAddress;
    bytes4[] functionSelectors;
}

struct RecipeEntry {
    bytes32 nameHash;
    uint64 version;
}

interface ILatticeFactory {
    function deploy(
        RecipeEntry[] calldata entries,
        FacetCut[] calldata customCuts,
        address init,
        bytes calldata initCalldata,
        bytes32 salt
    ) external returns (address diamond);

    function predict(address deployer, bytes32 salt) external view returns (address diamond);
}

interface IDiamondLoupe {
    function facets() external view returns (Facet[] memory);
}

struct ChainConfig {
    address factory;
    bytes32 factoryCodehash;
    bytes32 proxyInitCodeHash;
    string proxyCommit;
}

contract DeployERC20 is Script {
    error UnsupportedChain(uint256 chainId, string supportedChains);
    error MissingSharedContracts(string names, string howToDeploy);
    error UnexpectedCode(string contracts);
    error AddressTaken(address predicted);
    error PredictionDiffers(address expected, address actual);
    error FacetsDiffer(uint256 expected, uint256 actual);
    error UnexpectedFacet(address facet);
    error SelectorsDiffer(address facet);

    string internal constant PROJECT = "ERC20";
    bytes32 internal constant RECIPE_HASH = 0x359013116635a68e6fa13ab37e7882446a0a1e7afc8d7ce5adbac2a66181cab0;
    bytes1 internal constant SCOPE = 0x00;
    bytes11 internal constant ENTROPY = 0x0000000000000000000001;
    string internal constant SUPPORTED_CHAINS = "84532, 11155111";
    string internal constant MISSING_HELP =
        "Deploy them first with Deploy missing contracts\\u2026 in Lattice Studio or with the lattice-studio CLI.";

    // Shared contracts, at the addresses and codehashes the catalog pins.
    // ERC20
    address internal constant ERC20_ADDRESS = 0xcEA19e568b017a5DBc2FFBbEc9E37d1b874dF808;
    bytes32 internal constant ERC20_CODEHASH = 0xb2bdd94e24a77f078ecc3d7063e3fb7887a9f398749728cfa17039ff2eddc429;
    // Receive
    address internal constant RECEIVE_ADDRESS = 0x96E186Fea88E3cCe88ea390CDEEC846a78606812;
    bytes32 internal constant RECEIVE_CODEHASH = 0x618c1fd98e5806c5b441229b919c384b9846d05410bb885eb04dd0a2d0daa7ab;
    // DiamondLoupeFacet
    address internal constant DIAMOND_LOUPE_FACET_ADDRESS = 0x1398f1E9e9aCD915570Ac58AE98160Abc625325F;
    bytes32 internal constant DIAMOND_LOUPE_FACET_CODEHASH =
        0x5ececdca86d9f1fe420092767c7a1c70740e978a4fed181f23d309be460dc518;
    // ERC165Facet
    address internal constant ERC165_FACET_ADDRESS = 0x012f635B44Ba137d151A559ed500aAe2bc91432D;
    bytes32 internal constant ERC165_FACET_CODEHASH =
        0x55c3098887cc28912e2a5f435c4388d72389072a7dc9c9afd2a20cea4c9ed319;
    // ERC20Init
    address internal constant ERC20_INIT_ADDRESS = 0xeA18Bee1F2654037bDBf98655031B80Dcf8d657F;
    bytes32 internal constant ERC20_INIT_CODEHASH = 0xb9e797fb34143a1bf549cdfe1436cf15d739f12a82914cb08108f815d699011c;
    // DiamondIntrospectionInit
    address internal constant DIAMOND_INTROSPECTION_INIT_ADDRESS = 0x6593b49c0bb47eB56A308085694Cf33031b173B8;
    bytes32 internal constant DIAMOND_INTROSPECTION_INIT_CODEHASH =
        0xb2f88b327db02042a3c6b59ed83e76f9df2d6c7c38b2a30cc5d57158306950ef;
    // MultiInit
    address internal constant MULTI_INIT_ADDRESS = 0x11b7129d476d5a565Aee5A89aa81BB79D664eB3e;
    bytes32 internal constant MULTI_INIT_CODEHASH = 0xa6cbf8a81c7ed4913385d833a70b99557bfe158d6a7c5faa2a4aae4b83f23599;

    string internal missing;
    string internal wrongCode;

    function run() external returns (address diamond) {
        ChainConfig memory config = _chainConfig();
        _checkSharedContracts(config);

        vm.startBroadcast();
        (, address deployer,) = vm.readCallers();
        bytes32 salt = _salt(deployer);
        address predicted = _predict(config, deployer, salt);
        if (predicted.code.length != 0) revert AddressTaken(predicted);
        (address init, bytes memory initCalldata) = _init();
        RecipeEntry[] memory entries = new RecipeEntry[](0);
        diamond = ILatticeFactory(config.factory).deploy(entries, _cuts(), init, initCalldata, salt);
        vm.stopBroadcast();

        if (diamond != predicted) revert PredictionDiffers(predicted, diamond);
        _checkFacets(diamond);
        console.log("Deployed", PROJECT, "at", diamond);
        console.log("Recipe hash", vm.toString(RECIPE_HASH));
        console.log("Verify it from a Lattice checkout at commit", config.proxyCommit);
        console.log(
            string.concat(
                "FOUNDRY_PROFILE=ci forge verify-contract ",
                vm.toString(diamond),
                " src/Lattice.sol:Lattice --verifier sourcify --chain ",
                vm.toString(block.chainid)
            )
        );
    }

    function _chainConfig() internal view returns (ChainConfig memory config) {
        if (block.chainid == 84532) {
            config.factory = 0xc0eac9A5c061341447c7ffbdcAbF9aFc4A832326;
            config.factoryCodehash = 0xe2c27a322dc567b6cf13836027251994d3ce09185317ece7930a43d35313bc35;
            config.proxyInitCodeHash = 0x7cc787ff8e5606b9dcb9ff1b63e5e58570447e5a8d856c51cfa91cd4642001d0;
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        if (block.chainid == 11155111) {
            config.factory = 0xc0eac9A5c061341447c7ffbdcAbF9aFc4A832326;
            config.factoryCodehash = 0xe2c27a322dc567b6cf13836027251994d3ce09185317ece7930a43d35313bc35;
            config.proxyInitCodeHash = 0x7cc787ff8e5606b9dcb9ff1b63e5e58570447e5a8d856c51cfa91cd4642001d0;
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        revert UnsupportedChain(block.chainid, SUPPORTED_CHAINS);
    }

    function _checkSharedContracts(ChainConfig memory config) internal {
        _expect("LatticeFactory", config.factory, config.factoryCodehash);
        _expect("ERC20", ERC20_ADDRESS, ERC20_CODEHASH);
        _expect("Receive", RECEIVE_ADDRESS, RECEIVE_CODEHASH);
        _expect("DiamondLoupeFacet", DIAMOND_LOUPE_FACET_ADDRESS, DIAMOND_LOUPE_FACET_CODEHASH);
        _expect("ERC165Facet", ERC165_FACET_ADDRESS, ERC165_FACET_CODEHASH);
        _expect("ERC20Init", ERC20_INIT_ADDRESS, ERC20_INIT_CODEHASH);
        _expect("DiamondIntrospectionInit", DIAMOND_INTROSPECTION_INIT_ADDRESS, DIAMOND_INTROSPECTION_INIT_CODEHASH);
        _expect("MultiInit", MULTI_INIT_ADDRESS, MULTI_INIT_CODEHASH);
        if (bytes(wrongCode).length != 0) revert UnexpectedCode(wrongCode);
        if (bytes(missing).length != 0) revert MissingSharedContracts(missing, MISSING_HELP);
    }

    function _expect(string memory name, address target, bytes32 codehash) internal {
        if (target.code.length == 0) {
            missing = _join(missing, name);
        } else if (target.codehash != codehash) {
            wrongCode = _join(wrongCode, string.concat(name, " at ", vm.toString(target)));
        }
    }

    function _join(string memory list, string memory item) internal pure returns (string memory) {
        return bytes(list).length == 0 ? item : string.concat(list, ", ", item);
    }

    // from ‖ scope ‖ entropy: 20 + 1 + 11 bytes, the salt Lattice Studio builds for the deploying account.
    function _salt(address deployer) internal pure returns (bytes32) {
        return bytes32(bytes20(deployer)) | (bytes32(SCOPE) >> 160) | (bytes32(ENTROPY) >> 168);
    }

    // CREATE2 from the factory with keccak256(abi.encode(deployer, salt)), as LatticeFactory._saltFor folds it.
    function _predict(ChainConfig memory config, address deployer, bytes32 salt) internal view returns (address) {
        bytes32 folded = keccak256(abi.encode(deployer, salt));
        bytes32 digest = keccak256(abi.encodePacked(bytes1(0xff), config.factory, folded, config.proxyInitCodeHash));
        address predicted = address(uint160(uint256(digest)));
        address reported = ILatticeFactory(config.factory).predict(deployer, salt);
        if (reported != predicted) revert PredictionDiffers(predicted, reported);
        return predicted;
    }

    // facets() against the plan, per facet as sets: LatticeFactory applies registry cuts first, so order differs.
    function _checkFacets(address diamond) internal view {
        FacetCut[] memory cuts = _cuts();
        Facet[] memory facets = IDiamondLoupe(diamond).facets();
        if (facets.length != cuts.length) revert FacetsDiffer(cuts.length, facets.length);
        for (uint256 i; i < facets.length; ++i) {
            bytes4[] memory expected = _selectorsOf(cuts, facets[i].facetAddress);
            bytes4[] memory actual = facets[i].functionSelectors;
            if (expected.length != actual.length) revert SelectorsDiffer(facets[i].facetAddress);
            for (uint256 j; j < actual.length; ++j) {
                if (!_contains(expected, actual[j])) revert SelectorsDiffer(facets[i].facetAddress);
            }
        }
    }

    function _selectorsOf(FacetCut[] memory cuts, address facet) internal pure returns (bytes4[] memory) {
        for (uint256 i; i < cuts.length; ++i) {
            if (cuts[i].facetAddress == facet) return cuts[i].functionSelectors;
        }
        revert UnexpectedFacet(facet);
    }

    function _contains(bytes4[] memory list, bytes4 selector) internal pure returns (bool) {
        for (uint256 i; i < list.length; ++i) {
            if (list[i] == selector) return true;
        }
        return false;
    }

    function _cuts() internal pure returns (FacetCut[] memory cuts) {
        cuts = new FacetCut[](4);
        bytes4[] memory selectors;

        // ERC20 0.2.0
        selectors = new bytes4[](9);
        selectors[0] = bytes4(0xdd62ed3e); // allowance(address,address)
        selectors[1] = bytes4(0x095ea7b3); // approve(address,uint256)
        selectors[2] = bytes4(0x70a08231); // balanceOf(address)
        selectors[3] = bytes4(0x313ce567); // decimals()
        selectors[4] = bytes4(0x06fdde03); // name()
        selectors[5] = bytes4(0x95d89b41); // symbol()
        selectors[6] = bytes4(0x18160ddd); // totalSupply()
        selectors[7] = bytes4(0xa9059cbb); // transfer(address,uint256)
        selectors[8] = bytes4(0x23b872dd); // transferFrom(address,address,uint256)
        cuts[0] = FacetCut(ERC20_ADDRESS, FacetCutAction.Add, selectors);

        // Receive 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x00000000); // receive()
        cuts[1] = FacetCut(RECEIVE_ADDRESS, FacetCutAction.Add, selectors);

        // DiamondLoupeFacet 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0x7a0ed627); // facets()
        selectors[1] = bytes4(0xadfca15e); // facetFunctionSelectors(address)
        selectors[2] = bytes4(0x52ef6b2c); // facetAddresses()
        selectors[3] = bytes4(0xcdffacc6); // facetAddress(bytes4)
        cuts[2] = FacetCut(DIAMOND_LOUPE_FACET_ADDRESS, FacetCutAction.Add, selectors);

        // ERC165Facet 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x01ffc9a7); // supportsInterface(bytes4)
        cuts[3] = FacetCut(ERC165_FACET_ADDRESS, FacetCutAction.Add, selectors);
    }

    function _init() internal pure returns (address target, bytes memory data) {
        address[] memory targets = new address[](2);
        bytes[] memory calls = new bytes[](2);
        targets[0] = ERC20_INIT_ADDRESS;
        calls[0] = _initStep0();
        targets[1] = DIAMOND_INTROSPECTION_INIT_ADDRESS;
        calls[1] = _initStep1();
        target = MULTI_INIT_ADDRESS;
        // multiInit(address[],bytes[])
        data = abi.encodeWithSelector(bytes4(0x6e02fa3c), targets, calls);
    }

    // steps[0]: ERC20Init.init(string,string)
    function _initStep0() internal pure returns (bytes memory data) {
        data = abi.encodeWithSelector(bytes4(0x7029144c), "Example Token", "EXT");
    }

    // auto: DiamondIntrospectionInit.initImmutable()
    function _initStep1() internal pure returns (bytes memory data) {
        data = abi.encodeWithSelector(bytes4(0xd1a4dbd8));
    }
}
"
`;

exports[`exportFoundry snapshot: ERC20 through createx 1`] = `
"// SPDX-License-Identifier: MIT
// DeployERC20.s.sol: deploys the diamond "ERC20" as Lattice Studio composed it.
// Generated by Lattice Studio 0.1.0. The same recipe, catalog and inputs give the same bytes.
//
// Recipe hash: 0x359013116635a68e6fa13ab37e7882446a0a1e7afc8d7ce5adbac2a66181cab0
// Catalog: Lattice fixture at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79, catalog hash 0xce843be12f8b470d72cd0ddb41df9aed8a0c7d7abad718b34bb8b2731805ff24
// Provisional: Lattice 0.2.0 at dev f4a32c8; v1 targets 0.4.0. Fixture catalog: invented release data.
// Toolchain: Foundry 1.8.3, solc 0.8.36
// Deploys through: CreateX.deployCreate3AndInit, one transaction with its init
// Salt: deploying account, scope 0x01 (this-chain), entropy 0x0000000000000000000001
// Chains: 84532, 11155111
//
// Run:
//   forge script DeployERC20.s.sol --rpc-url $RPC_URL --account deployer --broadcast
// On Anvil, fork a supported chain where the shared contracts exist: anvil --fork-url $RPC_URL
//
// Before it broadcasts, the script checks that every shared contract's codehash matches the catalog, that the
// predicted address is empty, and that its own simulation of the deploy finds facets() equal to this plan:
//   ERC20 0.2.0, 9 selectors
//   Receive 0.2.0, 1 selector
//   DiamondLoupeFacet 0.2.0, 4 selectors
//   ERC165Facet 0.2.0, 1 selector
//
// Init: 2 calls through MultiInit
//   ERC20Init.init(string,string)
//   DiamondIntrospectionInit.initImmutable()
// References: "This diamond" is the predicted address; "Deploying account" is the broadcaster.
//
// Verify: the script creates no contract forge could match. Verify the diamond against the published Lattice
// standard JSON, in a Lattice checkout at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79:
//   FOUNDRY_PROFILE=ci forge verify-contract <diamond> src/Lattice.sol:Lattice --verifier sourcify --chain <chain id>
//
// Leaves out:
//   Deploying missing shared contracts: use Deploy missing contracts… in Lattice Studio or the lattice-studio CLI.
pragma solidity ^0.8.30;

import {Script} from "forge-std/Script.sol";
import {console} from "forge-std/console.sol";

// Lattice's diamond types (diamond-lib DiamondLib.sol and ILatticeFactory.sol at the pin), inlined.
enum FacetCutAction {
    Add,
    Replace,
    Remove
}

struct FacetCut {
    address facetAddress;
    FacetCutAction action;
    bytes4[] functionSelectors;
}

struct Facet {
    address facetAddress;
    bytes4[] functionSelectors;
}

interface ICreateX {
    struct Values {
        uint256 constructorAmount;
        uint256 initCallAmount;
    }

    function deployCreate3AndInit(bytes32 salt, bytes memory initCode, bytes memory data, Values memory values)
        external
        payable
        returns (address newContract);

    function computeCreate3Address(bytes32 salt) external view returns (address computedAddress);
}

interface ILattice {
    function initialize(FacetCut[] calldata facetCuts, address init, bytes calldata data) external payable;
}

interface IDiamondLoupe {
    function facets() external view returns (Facet[] memory);
}

struct ChainConfig {
    string proxyCommit;
}

contract DeployERC20 is Script {
    error UnsupportedChain(uint256 chainId, string supportedChains);
    error MissingSharedContracts(string names, string howToDeploy);
    error UnexpectedCode(string contracts);
    error AddressTaken(address predicted);
    error PredictionDiffers(address expected, address actual);
    error FacetsDiffer(uint256 expected, uint256 actual);
    error UnexpectedFacet(address facet);
    error SelectorsDiffer(address facet);

    string internal constant PROJECT = "ERC20";
    bytes32 internal constant RECIPE_HASH = 0x359013116635a68e6fa13ab37e7882446a0a1e7afc8d7ce5adbac2a66181cab0;
    bytes1 internal constant SCOPE = 0x01;
    bytes11 internal constant ENTROPY = 0x0000000000000000000001;
    string internal constant SUPPORTED_CHAINS = "84532, 11155111";
    string internal constant MISSING_HELP =
        "Deploy them first with Deploy missing contracts\\u2026 in Lattice Studio or with the lattice-studio CLI.";
    address internal constant CREATEX = 0xba5Ed099633D3B313e4D5F7bdc1305d3c28ba5Ed;
    bytes32 internal constant CREATE3_PROXY_CHILD_HASH =
        0x21c35dbe1b344a2488cf3321d6ce542f8e9f305544ff09e4993a62319a497c1f;
    bytes internal constant LATTICE_CREATION_CODE = hex"666978747572653a4c617474696365";

    // Shared contracts, at the addresses and codehashes the catalog pins.
    // ERC20
    address internal constant ERC20_ADDRESS = 0xcEA19e568b017a5DBc2FFBbEc9E37d1b874dF808;
    bytes32 internal constant ERC20_CODEHASH = 0xb2bdd94e24a77f078ecc3d7063e3fb7887a9f398749728cfa17039ff2eddc429;
    // Receive
    address internal constant RECEIVE_ADDRESS = 0x96E186Fea88E3cCe88ea390CDEEC846a78606812;
    bytes32 internal constant RECEIVE_CODEHASH = 0x618c1fd98e5806c5b441229b919c384b9846d05410bb885eb04dd0a2d0daa7ab;
    // DiamondLoupeFacet
    address internal constant DIAMOND_LOUPE_FACET_ADDRESS = 0x1398f1E9e9aCD915570Ac58AE98160Abc625325F;
    bytes32 internal constant DIAMOND_LOUPE_FACET_CODEHASH =
        0x5ececdca86d9f1fe420092767c7a1c70740e978a4fed181f23d309be460dc518;
    // ERC165Facet
    address internal constant ERC165_FACET_ADDRESS = 0x012f635B44Ba137d151A559ed500aAe2bc91432D;
    bytes32 internal constant ERC165_FACET_CODEHASH =
        0x55c3098887cc28912e2a5f435c4388d72389072a7dc9c9afd2a20cea4c9ed319;
    // ERC20Init
    address internal constant ERC20_INIT_ADDRESS = 0xeA18Bee1F2654037bDBf98655031B80Dcf8d657F;
    bytes32 internal constant ERC20_INIT_CODEHASH = 0xb9e797fb34143a1bf549cdfe1436cf15d739f12a82914cb08108f815d699011c;
    // DiamondIntrospectionInit
    address internal constant DIAMOND_INTROSPECTION_INIT_ADDRESS = 0x6593b49c0bb47eB56A308085694Cf33031b173B8;
    bytes32 internal constant DIAMOND_INTROSPECTION_INIT_CODEHASH =
        0xb2f88b327db02042a3c6b59ed83e76f9df2d6c7c38b2a30cc5d57158306950ef;
    // MultiInit
    address internal constant MULTI_INIT_ADDRESS = 0x11b7129d476d5a565Aee5A89aa81BB79D664eB3e;
    bytes32 internal constant MULTI_INIT_CODEHASH = 0xa6cbf8a81c7ed4913385d833a70b99557bfe158d6a7c5faa2a4aae4b83f23599;

    string internal missing;
    string internal wrongCode;

    function run() external returns (address diamond) {
        ChainConfig memory config = _chainConfig();
        _checkSharedContracts(config);

        vm.startBroadcast();
        (, address deployer,) = vm.readCallers();
        bytes32 salt = _salt(deployer);
        address predicted = _predict(config, deployer, salt);
        if (predicted.code.length != 0) revert AddressTaken(predicted);
        (address init, bytes memory initCalldata) = _init();
        bytes memory initialize = abi.encodeCall(ILattice.initialize, (_cuts(), init, initCalldata));
        ICreateX.Values memory values = ICreateX.Values(0, 0);
        diamond = ICreateX(CREATEX).deployCreate3AndInit(salt, LATTICE_CREATION_CODE, initialize, values);
        vm.stopBroadcast();

        if (diamond != predicted) revert PredictionDiffers(predicted, diamond);
        _checkFacets(diamond);
        console.log("Deployed", PROJECT, "at", diamond);
        console.log("Recipe hash", vm.toString(RECIPE_HASH));
        console.log("Verify it from a Lattice checkout at commit", config.proxyCommit);
        console.log(
            string.concat(
                "FOUNDRY_PROFILE=ci forge verify-contract ",
                vm.toString(diamond),
                " src/Lattice.sol:Lattice --verifier sourcify --chain ",
                vm.toString(block.chainid)
            )
        );
    }

    function _chainConfig() internal view returns (ChainConfig memory config) {
        if (block.chainid == 84532) {
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        if (block.chainid == 11155111) {
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        revert UnsupportedChain(block.chainid, SUPPORTED_CHAINS);
    }

    function _checkSharedContracts(ChainConfig memory) internal {
        if (CREATEX.code.length == 0) missing = "CreateX";
        _expect("ERC20", ERC20_ADDRESS, ERC20_CODEHASH);
        _expect("Receive", RECEIVE_ADDRESS, RECEIVE_CODEHASH);
        _expect("DiamondLoupeFacet", DIAMOND_LOUPE_FACET_ADDRESS, DIAMOND_LOUPE_FACET_CODEHASH);
        _expect("ERC165Facet", ERC165_FACET_ADDRESS, ERC165_FACET_CODEHASH);
        _expect("ERC20Init", ERC20_INIT_ADDRESS, ERC20_INIT_CODEHASH);
        _expect("DiamondIntrospectionInit", DIAMOND_INTROSPECTION_INIT_ADDRESS, DIAMOND_INTROSPECTION_INIT_CODEHASH);
        _expect("MultiInit", MULTI_INIT_ADDRESS, MULTI_INIT_CODEHASH);
        if (bytes(wrongCode).length != 0) revert UnexpectedCode(wrongCode);
        if (bytes(missing).length != 0) revert MissingSharedContracts(missing, MISSING_HELP);
    }

    function _expect(string memory name, address target, bytes32 codehash) internal {
        if (target.code.length == 0) {
            missing = _join(missing, name);
        } else if (target.codehash != codehash) {
            wrongCode = _join(wrongCode, string.concat(name, " at ", vm.toString(target)));
        }
    }

    function _join(string memory list, string memory item) internal pure returns (string memory) {
        return bytes(list).length == 0 ? item : string.concat(list, ", ", item);
    }

    // from ‖ scope ‖ entropy: 20 + 1 + 11 bytes, the salt Lattice Studio builds for the deploying account.
    function _salt(address deployer) internal pure returns (bytes32) {
        return bytes32(bytes20(deployer)) | (bytes32(SCOPE) >> 160) | (bytes32(ENTROPY) >> 168);
    }

    // CreateX guards a sender-prefixed salt, then CREATE3: a proxy at CREATE2(CreateX, guarded, child hash), then
    // the diamond at that proxy's first CREATE.
    function _predict(ChainConfig memory, address deployer, bytes32 salt) internal view returns (address) {
        bytes32 guarded = SCOPE == bytes1(0x01)
            ? keccak256(abi.encode(deployer, block.chainid, salt))
            : keccak256(abi.encode(deployer, salt));
        bytes32 digest = keccak256(abi.encodePacked(bytes1(0xff), CREATEX, guarded, CREATE3_PROXY_CHILD_HASH));
        address proxy = address(uint160(uint256(digest)));
        address predicted = address(uint160(uint256(keccak256(abi.encodePacked(hex"d694", proxy, hex"01")))));
        address reported = ICreateX(CREATEX).computeCreate3Address(guarded);
        if (reported != predicted) revert PredictionDiffers(predicted, reported);
        return predicted;
    }

    // facets() against the plan, per facet as sets: LatticeFactory applies registry cuts first, so order differs.
    function _checkFacets(address diamond) internal view {
        FacetCut[] memory cuts = _cuts();
        Facet[] memory facets = IDiamondLoupe(diamond).facets();
        if (facets.length != cuts.length) revert FacetsDiffer(cuts.length, facets.length);
        for (uint256 i; i < facets.length; ++i) {
            bytes4[] memory expected = _selectorsOf(cuts, facets[i].facetAddress);
            bytes4[] memory actual = facets[i].functionSelectors;
            if (expected.length != actual.length) revert SelectorsDiffer(facets[i].facetAddress);
            for (uint256 j; j < actual.length; ++j) {
                if (!_contains(expected, actual[j])) revert SelectorsDiffer(facets[i].facetAddress);
            }
        }
    }

    function _selectorsOf(FacetCut[] memory cuts, address facet) internal pure returns (bytes4[] memory) {
        for (uint256 i; i < cuts.length; ++i) {
            if (cuts[i].facetAddress == facet) return cuts[i].functionSelectors;
        }
        revert UnexpectedFacet(facet);
    }

    function _contains(bytes4[] memory list, bytes4 selector) internal pure returns (bool) {
        for (uint256 i; i < list.length; ++i) {
            if (list[i] == selector) return true;
        }
        return false;
    }

    function _cuts() internal pure returns (FacetCut[] memory cuts) {
        cuts = new FacetCut[](4);
        bytes4[] memory selectors;

        // ERC20 0.2.0
        selectors = new bytes4[](9);
        selectors[0] = bytes4(0xdd62ed3e); // allowance(address,address)
        selectors[1] = bytes4(0x095ea7b3); // approve(address,uint256)
        selectors[2] = bytes4(0x70a08231); // balanceOf(address)
        selectors[3] = bytes4(0x313ce567); // decimals()
        selectors[4] = bytes4(0x06fdde03); // name()
        selectors[5] = bytes4(0x95d89b41); // symbol()
        selectors[6] = bytes4(0x18160ddd); // totalSupply()
        selectors[7] = bytes4(0xa9059cbb); // transfer(address,uint256)
        selectors[8] = bytes4(0x23b872dd); // transferFrom(address,address,uint256)
        cuts[0] = FacetCut(ERC20_ADDRESS, FacetCutAction.Add, selectors);

        // Receive 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x00000000); // receive()
        cuts[1] = FacetCut(RECEIVE_ADDRESS, FacetCutAction.Add, selectors);

        // DiamondLoupeFacet 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0x7a0ed627); // facets()
        selectors[1] = bytes4(0xadfca15e); // facetFunctionSelectors(address)
        selectors[2] = bytes4(0x52ef6b2c); // facetAddresses()
        selectors[3] = bytes4(0xcdffacc6); // facetAddress(bytes4)
        cuts[2] = FacetCut(DIAMOND_LOUPE_FACET_ADDRESS, FacetCutAction.Add, selectors);

        // ERC165Facet 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x01ffc9a7); // supportsInterface(bytes4)
        cuts[3] = FacetCut(ERC165_FACET_ADDRESS, FacetCutAction.Add, selectors);
    }

    function _init() internal pure returns (address target, bytes memory data) {
        address[] memory targets = new address[](2);
        bytes[] memory calls = new bytes[](2);
        targets[0] = ERC20_INIT_ADDRESS;
        calls[0] = _initStep0();
        targets[1] = DIAMOND_INTROSPECTION_INIT_ADDRESS;
        calls[1] = _initStep1();
        target = MULTI_INIT_ADDRESS;
        // multiInit(address[],bytes[])
        data = abi.encodeWithSelector(bytes4(0x6e02fa3c), targets, calls);
    }

    // steps[0]: ERC20Init.init(string,string)
    function _initStep0() internal pure returns (bytes memory data) {
        data = abi.encodeWithSelector(bytes4(0x7029144c), "Example Token", "EXT");
    }

    // auto: DiamondIntrospectionInit.initImmutable()
    function _initStep1() internal pure returns (bytes memory data) {
        data = abi.encodeWithSelector(bytes4(0xd1a4dbd8));
    }
}
"
`;

exports[`exportFoundry snapshot: SafeDiamondCut through factory 1`] = `
"// SPDX-License-Identifier: MIT
// DeploySafeDiamondCut.s.sol: deploys the diamond "SafeDiamondCut" as Lattice Studio composed it.
// Generated by Lattice Studio 0.1.0. The same recipe, catalog and inputs give the same bytes.
//
// Recipe hash: 0xf29a64e2b82db953c31ea99fa0b6174cd0afed6b784dc078075c8312c6376f8d
// Catalog: Lattice fixture at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79, catalog hash 0xce843be12f8b470d72cd0ddb41df9aed8a0c7d7abad718b34bb8b2731805ff24
// Provisional: Lattice 0.2.0 at dev f4a32c8; v1 targets 0.4.0. Fixture catalog: invented release data.
// Toolchain: Foundry 1.8.3, solc 0.8.36
// Deploys through: LatticeFactory.deploy, one transaction with its init
// Salt: deploying account, scope 0x00 (every-chain), entropy 0x0000000000000000000001
// Chains: 84532, 11155111
//
// Run:
//   forge script DeploySafeDiamondCut.s.sol --rpc-url $RPC_URL --account deployer --broadcast
// On Anvil, fork a supported chain where the shared contracts exist: anvil --fork-url $RPC_URL
//
// Before it broadcasts, the script checks that every shared contract's codehash matches the catalog, that the
// predicted address is empty, and that its own simulation of the deploy finds facets() equal to this plan:
//   SafeDiamondCut 0.2.0, 11 selectors
//   EmergencyStop 0.2.0, 7 selectors
//   AccessControl 0.2.0, 5 selectors
//   Receive 0.2.0, 1 selector
//   DiamondLoupeFacet 0.2.0, 4 selectors
//   ERC165Facet 0.2.0, 1 selector
//
// Init: one direct call
//   SafeDiamondCutInit.init(address,address,uint256)
// References: "This diamond" is the predicted address; "Deploying account" is the broadcaster.
//
// Verify: the script creates no contract forge could match. Verify the diamond against the published Lattice
// standard JSON, in a Lattice checkout at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79:
//   FOUNDRY_PROFILE=ci forge verify-contract <diamond> src/Lattice.sol:Lattice --verifier sourcify --chain <chain id>
//
// Leaves out:
//   Deploying missing shared contracts: use Deploy missing contracts… in Lattice Studio or the lattice-studio CLI.
pragma solidity ^0.8.30;

import {Script} from "forge-std/Script.sol";
import {console} from "forge-std/console.sol";

// Lattice's diamond types (diamond-lib DiamondLib.sol and ILatticeFactory.sol at the pin), inlined.
enum FacetCutAction {
    Add,
    Replace,
    Remove
}

struct FacetCut {
    address facetAddress;
    FacetCutAction action;
    bytes4[] functionSelectors;
}

struct Facet {
    address facetAddress;
    bytes4[] functionSelectors;
}

struct RecipeEntry {
    bytes32 nameHash;
    uint64 version;
}

interface ILatticeFactory {
    function deploy(
        RecipeEntry[] calldata entries,
        FacetCut[] calldata customCuts,
        address init,
        bytes calldata initCalldata,
        bytes32 salt
    ) external returns (address diamond);

    function predict(address deployer, bytes32 salt) external view returns (address diamond);
}

interface IDiamondLoupe {
    function facets() external view returns (Facet[] memory);
}

struct ChainConfig {
    address factory;
    bytes32 factoryCodehash;
    bytes32 proxyInitCodeHash;
    string proxyCommit;
}

contract DeploySafeDiamondCut is Script {
    error UnsupportedChain(uint256 chainId, string supportedChains);
    error MissingSharedContracts(string names, string howToDeploy);
    error UnexpectedCode(string contracts);
    error AddressTaken(address predicted);
    error PredictionDiffers(address expected, address actual);
    error FacetsDiffer(uint256 expected, uint256 actual);
    error UnexpectedFacet(address facet);
    error SelectorsDiffer(address facet);

    string internal constant PROJECT = "SafeDiamondCut";
    bytes32 internal constant RECIPE_HASH = 0xf29a64e2b82db953c31ea99fa0b6174cd0afed6b784dc078075c8312c6376f8d;
    bytes1 internal constant SCOPE = 0x00;
    bytes11 internal constant ENTROPY = 0x0000000000000000000001;
    string internal constant SUPPORTED_CHAINS = "84532, 11155111";
    string internal constant MISSING_HELP =
        "Deploy them first with Deploy missing contracts\\u2026 in Lattice Studio or with the lattice-studio CLI.";

    // Shared contracts, at the addresses and codehashes the catalog pins.
    // SafeDiamondCut
    address internal constant SAFE_DIAMOND_CUT_ADDRESS = 0xE1F3a95fb4765c3d215D538D6412D5440B639CFF;
    bytes32 internal constant SAFE_DIAMOND_CUT_CODEHASH =
        0x892c845146e318def0ef1755d60e51245a0356824ad91bc29acade5162ae7450;
    // EmergencyStop
    address internal constant EMERGENCY_STOP_ADDRESS = 0x0Af4CDFAA22B63C9731652A8Cd603e14f89d07F1;
    bytes32 internal constant EMERGENCY_STOP_CODEHASH =
        0xf280916d758b8ac4a20583c038740275d341dffa4cb55dbf653cfb9400090eef;
    // AccessControl
    address internal constant ACCESS_CONTROL_ADDRESS = 0xC31C375CD6003764be3C0F049587De2a15247fF1;
    bytes32 internal constant ACCESS_CONTROL_CODEHASH =
        0x609e15ee4618e038bb5734dae08499fb76f5cf58cd9b7d1f71abdcc79e9e4b87;
    // Receive
    address internal constant RECEIVE_ADDRESS = 0x96E186Fea88E3cCe88ea390CDEEC846a78606812;
    bytes32 internal constant RECEIVE_CODEHASH = 0x618c1fd98e5806c5b441229b919c384b9846d05410bb885eb04dd0a2d0daa7ab;
    // DiamondLoupeFacet
    address internal constant DIAMOND_LOUPE_FACET_ADDRESS = 0x1398f1E9e9aCD915570Ac58AE98160Abc625325F;
    bytes32 internal constant DIAMOND_LOUPE_FACET_CODEHASH =
        0x5ececdca86d9f1fe420092767c7a1c70740e978a4fed181f23d309be460dc518;
    // ERC165Facet
    address internal constant ERC165_FACET_ADDRESS = 0x012f635B44Ba137d151A559ed500aAe2bc91432D;
    bytes32 internal constant ERC165_FACET_CODEHASH =
        0x55c3098887cc28912e2a5f435c4388d72389072a7dc9c9afd2a20cea4c9ed319;
    // SafeDiamondCutInit
    address internal constant SAFE_DIAMOND_CUT_INIT_ADDRESS = 0x20d80fCbF6b52dA2cECCea009a70604D989cab67;
    bytes32 internal constant SAFE_DIAMOND_CUT_INIT_CODEHASH =
        0x3e07637547e18e867f1ce9560e3aa17af14c45511aa3ffcf3aa32618c0bae543;

    string internal missing;
    string internal wrongCode;

    function run() external returns (address diamond) {
        ChainConfig memory config = _chainConfig();
        _checkSharedContracts(config);

        vm.startBroadcast();
        (, address deployer,) = vm.readCallers();
        bytes32 salt = _salt(deployer);
        address predicted = _predict(config, deployer, salt);
        if (predicted.code.length != 0) revert AddressTaken(predicted);
        (address init, bytes memory initCalldata) = _init(deployer);
        RecipeEntry[] memory entries = new RecipeEntry[](0);
        diamond = ILatticeFactory(config.factory).deploy(entries, _cuts(), init, initCalldata, salt);
        vm.stopBroadcast();

        if (diamond != predicted) revert PredictionDiffers(predicted, diamond);
        _checkFacets(diamond);
        console.log("Deployed", PROJECT, "at", diamond);
        console.log("Recipe hash", vm.toString(RECIPE_HASH));
        console.log("Verify it from a Lattice checkout at commit", config.proxyCommit);
        console.log(
            string.concat(
                "FOUNDRY_PROFILE=ci forge verify-contract ",
                vm.toString(diamond),
                " src/Lattice.sol:Lattice --verifier sourcify --chain ",
                vm.toString(block.chainid)
            )
        );
    }

    function _chainConfig() internal view returns (ChainConfig memory config) {
        if (block.chainid == 84532) {
            config.factory = 0xc0eac9A5c061341447c7ffbdcAbF9aFc4A832326;
            config.factoryCodehash = 0xe2c27a322dc567b6cf13836027251994d3ce09185317ece7930a43d35313bc35;
            config.proxyInitCodeHash = 0x7cc787ff8e5606b9dcb9ff1b63e5e58570447e5a8d856c51cfa91cd4642001d0;
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        if (block.chainid == 11155111) {
            config.factory = 0xc0eac9A5c061341447c7ffbdcAbF9aFc4A832326;
            config.factoryCodehash = 0xe2c27a322dc567b6cf13836027251994d3ce09185317ece7930a43d35313bc35;
            config.proxyInitCodeHash = 0x7cc787ff8e5606b9dcb9ff1b63e5e58570447e5a8d856c51cfa91cd4642001d0;
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        revert UnsupportedChain(block.chainid, SUPPORTED_CHAINS);
    }

    function _checkSharedContracts(ChainConfig memory config) internal {
        _expect("LatticeFactory", config.factory, config.factoryCodehash);
        _expect("SafeDiamondCut", SAFE_DIAMOND_CUT_ADDRESS, SAFE_DIAMOND_CUT_CODEHASH);
        _expect("EmergencyStop", EMERGENCY_STOP_ADDRESS, EMERGENCY_STOP_CODEHASH);
        _expect("AccessControl", ACCESS_CONTROL_ADDRESS, ACCESS_CONTROL_CODEHASH);
        _expect("Receive", RECEIVE_ADDRESS, RECEIVE_CODEHASH);
        _expect("DiamondLoupeFacet", DIAMOND_LOUPE_FACET_ADDRESS, DIAMOND_LOUPE_FACET_CODEHASH);
        _expect("ERC165Facet", ERC165_FACET_ADDRESS, ERC165_FACET_CODEHASH);
        _expect("SafeDiamondCutInit", SAFE_DIAMOND_CUT_INIT_ADDRESS, SAFE_DIAMOND_CUT_INIT_CODEHASH);
        if (bytes(wrongCode).length != 0) revert UnexpectedCode(wrongCode);
        if (bytes(missing).length != 0) revert MissingSharedContracts(missing, MISSING_HELP);
    }

    function _expect(string memory name, address target, bytes32 codehash) internal {
        if (target.code.length == 0) {
            missing = _join(missing, name);
        } else if (target.codehash != codehash) {
            wrongCode = _join(wrongCode, string.concat(name, " at ", vm.toString(target)));
        }
    }

    function _join(string memory list, string memory item) internal pure returns (string memory) {
        return bytes(list).length == 0 ? item : string.concat(list, ", ", item);
    }

    // from ‖ scope ‖ entropy: 20 + 1 + 11 bytes, the salt Lattice Studio builds for the deploying account.
    function _salt(address deployer) internal pure returns (bytes32) {
        return bytes32(bytes20(deployer)) | (bytes32(SCOPE) >> 160) | (bytes32(ENTROPY) >> 168);
    }

    // CREATE2 from the factory with keccak256(abi.encode(deployer, salt)), as LatticeFactory._saltFor folds it.
    function _predict(ChainConfig memory config, address deployer, bytes32 salt) internal view returns (address) {
        bytes32 folded = keccak256(abi.encode(deployer, salt));
        bytes32 digest = keccak256(abi.encodePacked(bytes1(0xff), config.factory, folded, config.proxyInitCodeHash));
        address predicted = address(uint160(uint256(digest)));
        address reported = ILatticeFactory(config.factory).predict(deployer, salt);
        if (reported != predicted) revert PredictionDiffers(predicted, reported);
        return predicted;
    }

    // facets() against the plan, per facet as sets: LatticeFactory applies registry cuts first, so order differs.
    function _checkFacets(address diamond) internal view {
        FacetCut[] memory cuts = _cuts();
        Facet[] memory facets = IDiamondLoupe(diamond).facets();
        if (facets.length != cuts.length) revert FacetsDiffer(cuts.length, facets.length);
        for (uint256 i; i < facets.length; ++i) {
            bytes4[] memory expected = _selectorsOf(cuts, facets[i].facetAddress);
            bytes4[] memory actual = facets[i].functionSelectors;
            if (expected.length != actual.length) revert SelectorsDiffer(facets[i].facetAddress);
            for (uint256 j; j < actual.length; ++j) {
                if (!_contains(expected, actual[j])) revert SelectorsDiffer(facets[i].facetAddress);
            }
        }
    }

    function _selectorsOf(FacetCut[] memory cuts, address facet) internal pure returns (bytes4[] memory) {
        for (uint256 i; i < cuts.length; ++i) {
            if (cuts[i].facetAddress == facet) return cuts[i].functionSelectors;
        }
        revert UnexpectedFacet(facet);
    }

    function _contains(bytes4[] memory list, bytes4 selector) internal pure returns (bool) {
        for (uint256 i; i < list.length; ++i) {
            if (list[i] == selector) return true;
        }
        return false;
    }

    function _cuts() internal pure returns (FacetCut[] memory cuts) {
        cuts = new FacetCut[](6);
        bytes4[] memory selectors;

        // SafeDiamondCut 0.2.0
        selectors = new bytes4[](11);
        selectors[0] = bytes4(0xaa982c45); // cutCount()
        selectors[1] = bytes4(0x1f931c1c); // diamondCut((address,uint8,bytes4[])[],address,bytes)
        selectors[2] = bytes4(0xc83542a6); // emergencyRemoveCut((address,uint8,bytes4[])[])
        selectors[3] = bytes4(0x4487678f); // freezeSelectors(bytes4[])
        selectors[4] = bytes4(0x22cabf70); // frozenSelectors()
        selectors[5] = bytes4(0x3adda78e); // getCutRecord(uint256)
        selectors[6] = bytes4(0xc8d8e114); // isSelectorFrozen(bytes4)
        selectors[7] = bytes4(0x35342750); // previewCut((address,uint8,bytes4[])[])
        selectors[8] = bytes4(0x186f0354); // safe()
        selectors[9] = bytes4(0x5db0cb94); // setSafe(address)
        selectors[10] = bytes4(0x0746a956); // verifyInterfaceRegistered(bytes4)
        cuts[0] = FacetCut(SAFE_DIAMOND_CUT_ADDRESS, FacetCutAction.Add, selectors);

        // EmergencyStop 0.2.0
        selectors = new bytes4[](7);
        selectors[0] = bytes4(0xa526d83b); // addGuardian(address)
        selectors[1] = bytes4(0x93c87f03); // emergencyResume()
        selectors[2] = bytes4(0xb1e3268b); // emergencyStop(string)
        selectors[3] = bytes4(0x0c68ba21); // isGuardian(address)
        selectors[4] = bytes4(0x3f683b6a); // isStopped()
        selectors[5] = bytes4(0x71404156); // removeGuardian(address)
        selectors[6] = bytes4(0x5b0b0c07); // stoppedReason()
        cuts[1] = FacetCut(EMERGENCY_STOP_ADDRESS, FacetCutAction.Add, selectors);

        // AccessControl 0.2.0
        selectors = new bytes4[](5);
        selectors[0] = bytes4(0x248a9ca3); // getRoleAdmin(bytes32)
        selectors[1] = bytes4(0x2f2ff15d); // grantRole(bytes32,address)
        selectors[2] = bytes4(0x91d14854); // hasRole(bytes32,address)
        selectors[3] = bytes4(0x36568abe); // renounceRole(bytes32,address)
        selectors[4] = bytes4(0xd547741f); // revokeRole(bytes32,address)
        cuts[2] = FacetCut(ACCESS_CONTROL_ADDRESS, FacetCutAction.Add, selectors);

        // Receive 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x00000000); // receive()
        cuts[3] = FacetCut(RECEIVE_ADDRESS, FacetCutAction.Add, selectors);

        // DiamondLoupeFacet 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0x7a0ed627); // facets()
        selectors[1] = bytes4(0xadfca15e); // facetFunctionSelectors(address)
        selectors[2] = bytes4(0x52ef6b2c); // facetAddresses()
        selectors[3] = bytes4(0xcdffacc6); // facetAddress(bytes4)
        cuts[4] = FacetCut(DIAMOND_LOUPE_FACET_ADDRESS, FacetCutAction.Add, selectors);

        // ERC165Facet 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x01ffc9a7); // supportsInterface(bytes4)
        cuts[5] = FacetCut(ERC165_FACET_ADDRESS, FacetCutAction.Add, selectors);
    }

    function _init(address deployer) internal pure returns (address target, bytes memory data) {
        target = SAFE_DIAMOND_CUT_INIT_ADDRESS;
        data = _initStep0(deployer);
    }

    // steps[0]: SafeDiamondCutInit.init(address,address,uint256)
    function _initStep0(address deployer) internal pure returns (bytes memory data) {
        data = abi.encodeWithSelector(
            bytes4(0x86863ec6), deployer, 0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed, uint256(2)
        );
    }
}
"
`;

exports[`exportFoundry snapshot: SafeDiamondCut through createx 1`] = `
"// SPDX-License-Identifier: MIT
// DeploySafeDiamondCut.s.sol: deploys the diamond "SafeDiamondCut" as Lattice Studio composed it.
// Generated by Lattice Studio 0.1.0. The same recipe, catalog and inputs give the same bytes.
//
// Recipe hash: 0xf29a64e2b82db953c31ea99fa0b6174cd0afed6b784dc078075c8312c6376f8d
// Catalog: Lattice fixture at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79, catalog hash 0xce843be12f8b470d72cd0ddb41df9aed8a0c7d7abad718b34bb8b2731805ff24
// Provisional: Lattice 0.2.0 at dev f4a32c8; v1 targets 0.4.0. Fixture catalog: invented release data.
// Toolchain: Foundry 1.8.3, solc 0.8.36
// Deploys through: CreateX.deployCreate3AndInit, one transaction with its init
// Salt: deploying account, scope 0x01 (this-chain), entropy 0x0000000000000000000001
// Chains: 84532, 11155111
//
// Run:
//   forge script DeploySafeDiamondCut.s.sol --rpc-url $RPC_URL --account deployer --broadcast
// On Anvil, fork a supported chain where the shared contracts exist: anvil --fork-url $RPC_URL
//
// Before it broadcasts, the script checks that every shared contract's codehash matches the catalog, that the
// predicted address is empty, and that its own simulation of the deploy finds facets() equal to this plan:
//   SafeDiamondCut 0.2.0, 11 selectors
//   EmergencyStop 0.2.0, 7 selectors
//   AccessControl 0.2.0, 5 selectors
//   Receive 0.2.0, 1 selector
//   DiamondLoupeFacet 0.2.0, 4 selectors
//   ERC165Facet 0.2.0, 1 selector
//
// Init: one direct call
//   SafeDiamondCutInit.init(address,address,uint256)
// References: "This diamond" is the predicted address; "Deploying account" is the broadcaster.
//
// Verify: the script creates no contract forge could match. Verify the diamond against the published Lattice
// standard JSON, in a Lattice checkout at commit f4a32c8330934d39bcfdffff87d35a04b7fa6a79:
//   FOUNDRY_PROFILE=ci forge verify-contract <diamond> src/Lattice.sol:Lattice --verifier sourcify --chain <chain id>
//
// Leaves out:
//   Deploying missing shared contracts: use Deploy missing contracts… in Lattice Studio or the lattice-studio CLI.
pragma solidity ^0.8.30;

import {Script} from "forge-std/Script.sol";
import {console} from "forge-std/console.sol";

// Lattice's diamond types (diamond-lib DiamondLib.sol and ILatticeFactory.sol at the pin), inlined.
enum FacetCutAction {
    Add,
    Replace,
    Remove
}

struct FacetCut {
    address facetAddress;
    FacetCutAction action;
    bytes4[] functionSelectors;
}

struct Facet {
    address facetAddress;
    bytes4[] functionSelectors;
}

interface ICreateX {
    struct Values {
        uint256 constructorAmount;
        uint256 initCallAmount;
    }

    function deployCreate3AndInit(bytes32 salt, bytes memory initCode, bytes memory data, Values memory values)
        external
        payable
        returns (address newContract);

    function computeCreate3Address(bytes32 salt) external view returns (address computedAddress);
}

interface ILattice {
    function initialize(FacetCut[] calldata facetCuts, address init, bytes calldata data) external payable;
}

interface IDiamondLoupe {
    function facets() external view returns (Facet[] memory);
}

struct ChainConfig {
    string proxyCommit;
}

contract DeploySafeDiamondCut is Script {
    error UnsupportedChain(uint256 chainId, string supportedChains);
    error MissingSharedContracts(string names, string howToDeploy);
    error UnexpectedCode(string contracts);
    error AddressTaken(address predicted);
    error PredictionDiffers(address expected, address actual);
    error FacetsDiffer(uint256 expected, uint256 actual);
    error UnexpectedFacet(address facet);
    error SelectorsDiffer(address facet);

    string internal constant PROJECT = "SafeDiamondCut";
    bytes32 internal constant RECIPE_HASH = 0xf29a64e2b82db953c31ea99fa0b6174cd0afed6b784dc078075c8312c6376f8d;
    bytes1 internal constant SCOPE = 0x01;
    bytes11 internal constant ENTROPY = 0x0000000000000000000001;
    string internal constant SUPPORTED_CHAINS = "84532, 11155111";
    string internal constant MISSING_HELP =
        "Deploy them first with Deploy missing contracts\\u2026 in Lattice Studio or with the lattice-studio CLI.";
    address internal constant CREATEX = 0xba5Ed099633D3B313e4D5F7bdc1305d3c28ba5Ed;
    bytes32 internal constant CREATE3_PROXY_CHILD_HASH =
        0x21c35dbe1b344a2488cf3321d6ce542f8e9f305544ff09e4993a62319a497c1f;
    bytes internal constant LATTICE_CREATION_CODE = hex"666978747572653a4c617474696365";

    // Shared contracts, at the addresses and codehashes the catalog pins.
    // SafeDiamondCut
    address internal constant SAFE_DIAMOND_CUT_ADDRESS = 0xE1F3a95fb4765c3d215D538D6412D5440B639CFF;
    bytes32 internal constant SAFE_DIAMOND_CUT_CODEHASH =
        0x892c845146e318def0ef1755d60e51245a0356824ad91bc29acade5162ae7450;
    // EmergencyStop
    address internal constant EMERGENCY_STOP_ADDRESS = 0x0Af4CDFAA22B63C9731652A8Cd603e14f89d07F1;
    bytes32 internal constant EMERGENCY_STOP_CODEHASH =
        0xf280916d758b8ac4a20583c038740275d341dffa4cb55dbf653cfb9400090eef;
    // AccessControl
    address internal constant ACCESS_CONTROL_ADDRESS = 0xC31C375CD6003764be3C0F049587De2a15247fF1;
    bytes32 internal constant ACCESS_CONTROL_CODEHASH =
        0x609e15ee4618e038bb5734dae08499fb76f5cf58cd9b7d1f71abdcc79e9e4b87;
    // Receive
    address internal constant RECEIVE_ADDRESS = 0x96E186Fea88E3cCe88ea390CDEEC846a78606812;
    bytes32 internal constant RECEIVE_CODEHASH = 0x618c1fd98e5806c5b441229b919c384b9846d05410bb885eb04dd0a2d0daa7ab;
    // DiamondLoupeFacet
    address internal constant DIAMOND_LOUPE_FACET_ADDRESS = 0x1398f1E9e9aCD915570Ac58AE98160Abc625325F;
    bytes32 internal constant DIAMOND_LOUPE_FACET_CODEHASH =
        0x5ececdca86d9f1fe420092767c7a1c70740e978a4fed181f23d309be460dc518;
    // ERC165Facet
    address internal constant ERC165_FACET_ADDRESS = 0x012f635B44Ba137d151A559ed500aAe2bc91432D;
    bytes32 internal constant ERC165_FACET_CODEHASH =
        0x55c3098887cc28912e2a5f435c4388d72389072a7dc9c9afd2a20cea4c9ed319;
    // SafeDiamondCutInit
    address internal constant SAFE_DIAMOND_CUT_INIT_ADDRESS = 0x20d80fCbF6b52dA2cECCea009a70604D989cab67;
    bytes32 internal constant SAFE_DIAMOND_CUT_INIT_CODEHASH =
        0x3e07637547e18e867f1ce9560e3aa17af14c45511aa3ffcf3aa32618c0bae543;

    string internal missing;
    string internal wrongCode;

    function run() external returns (address diamond) {
        ChainConfig memory config = _chainConfig();
        _checkSharedContracts(config);

        vm.startBroadcast();
        (, address deployer,) = vm.readCallers();
        bytes32 salt = _salt(deployer);
        address predicted = _predict(config, deployer, salt);
        if (predicted.code.length != 0) revert AddressTaken(predicted);
        (address init, bytes memory initCalldata) = _init(deployer);
        bytes memory initialize = abi.encodeCall(ILattice.initialize, (_cuts(), init, initCalldata));
        ICreateX.Values memory values = ICreateX.Values(0, 0);
        diamond = ICreateX(CREATEX).deployCreate3AndInit(salt, LATTICE_CREATION_CODE, initialize, values);
        vm.stopBroadcast();

        if (diamond != predicted) revert PredictionDiffers(predicted, diamond);
        _checkFacets(diamond);
        console.log("Deployed", PROJECT, "at", diamond);
        console.log("Recipe hash", vm.toString(RECIPE_HASH));
        console.log("Verify it from a Lattice checkout at commit", config.proxyCommit);
        console.log(
            string.concat(
                "FOUNDRY_PROFILE=ci forge verify-contract ",
                vm.toString(diamond),
                " src/Lattice.sol:Lattice --verifier sourcify --chain ",
                vm.toString(block.chainid)
            )
        );
    }

    function _chainConfig() internal view returns (ChainConfig memory config) {
        if (block.chainid == 84532) {
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        if (block.chainid == 11155111) {
            config.proxyCommit = "f4a32c8330934d39bcfdffff87d35a04b7fa6a79";
            return config;
        }
        revert UnsupportedChain(block.chainid, SUPPORTED_CHAINS);
    }

    function _checkSharedContracts(ChainConfig memory) internal {
        if (CREATEX.code.length == 0) missing = "CreateX";
        _expect("SafeDiamondCut", SAFE_DIAMOND_CUT_ADDRESS, SAFE_DIAMOND_CUT_CODEHASH);
        _expect("EmergencyStop", EMERGENCY_STOP_ADDRESS, EMERGENCY_STOP_CODEHASH);
        _expect("AccessControl", ACCESS_CONTROL_ADDRESS, ACCESS_CONTROL_CODEHASH);
        _expect("Receive", RECEIVE_ADDRESS, RECEIVE_CODEHASH);
        _expect("DiamondLoupeFacet", DIAMOND_LOUPE_FACET_ADDRESS, DIAMOND_LOUPE_FACET_CODEHASH);
        _expect("ERC165Facet", ERC165_FACET_ADDRESS, ERC165_FACET_CODEHASH);
        _expect("SafeDiamondCutInit", SAFE_DIAMOND_CUT_INIT_ADDRESS, SAFE_DIAMOND_CUT_INIT_CODEHASH);
        if (bytes(wrongCode).length != 0) revert UnexpectedCode(wrongCode);
        if (bytes(missing).length != 0) revert MissingSharedContracts(missing, MISSING_HELP);
    }

    function _expect(string memory name, address target, bytes32 codehash) internal {
        if (target.code.length == 0) {
            missing = _join(missing, name);
        } else if (target.codehash != codehash) {
            wrongCode = _join(wrongCode, string.concat(name, " at ", vm.toString(target)));
        }
    }

    function _join(string memory list, string memory item) internal pure returns (string memory) {
        return bytes(list).length == 0 ? item : string.concat(list, ", ", item);
    }

    // from ‖ scope ‖ entropy: 20 + 1 + 11 bytes, the salt Lattice Studio builds for the deploying account.
    function _salt(address deployer) internal pure returns (bytes32) {
        return bytes32(bytes20(deployer)) | (bytes32(SCOPE) >> 160) | (bytes32(ENTROPY) >> 168);
    }

    // CreateX guards a sender-prefixed salt, then CREATE3: a proxy at CREATE2(CreateX, guarded, child hash), then
    // the diamond at that proxy's first CREATE.
    function _predict(ChainConfig memory, address deployer, bytes32 salt) internal view returns (address) {
        bytes32 guarded = SCOPE == bytes1(0x01)
            ? keccak256(abi.encode(deployer, block.chainid, salt))
            : keccak256(abi.encode(deployer, salt));
        bytes32 digest = keccak256(abi.encodePacked(bytes1(0xff), CREATEX, guarded, CREATE3_PROXY_CHILD_HASH));
        address proxy = address(uint160(uint256(digest)));
        address predicted = address(uint160(uint256(keccak256(abi.encodePacked(hex"d694", proxy, hex"01")))));
        address reported = ICreateX(CREATEX).computeCreate3Address(guarded);
        if (reported != predicted) revert PredictionDiffers(predicted, reported);
        return predicted;
    }

    // facets() against the plan, per facet as sets: LatticeFactory applies registry cuts first, so order differs.
    function _checkFacets(address diamond) internal view {
        FacetCut[] memory cuts = _cuts();
        Facet[] memory facets = IDiamondLoupe(diamond).facets();
        if (facets.length != cuts.length) revert FacetsDiffer(cuts.length, facets.length);
        for (uint256 i; i < facets.length; ++i) {
            bytes4[] memory expected = _selectorsOf(cuts, facets[i].facetAddress);
            bytes4[] memory actual = facets[i].functionSelectors;
            if (expected.length != actual.length) revert SelectorsDiffer(facets[i].facetAddress);
            for (uint256 j; j < actual.length; ++j) {
                if (!_contains(expected, actual[j])) revert SelectorsDiffer(facets[i].facetAddress);
            }
        }
    }

    function _selectorsOf(FacetCut[] memory cuts, address facet) internal pure returns (bytes4[] memory) {
        for (uint256 i; i < cuts.length; ++i) {
            if (cuts[i].facetAddress == facet) return cuts[i].functionSelectors;
        }
        revert UnexpectedFacet(facet);
    }

    function _contains(bytes4[] memory list, bytes4 selector) internal pure returns (bool) {
        for (uint256 i; i < list.length; ++i) {
            if (list[i] == selector) return true;
        }
        return false;
    }

    function _cuts() internal pure returns (FacetCut[] memory cuts) {
        cuts = new FacetCut[](6);
        bytes4[] memory selectors;

        // SafeDiamondCut 0.2.0
        selectors = new bytes4[](11);
        selectors[0] = bytes4(0xaa982c45); // cutCount()
        selectors[1] = bytes4(0x1f931c1c); // diamondCut((address,uint8,bytes4[])[],address,bytes)
        selectors[2] = bytes4(0xc83542a6); // emergencyRemoveCut((address,uint8,bytes4[])[])
        selectors[3] = bytes4(0x4487678f); // freezeSelectors(bytes4[])
        selectors[4] = bytes4(0x22cabf70); // frozenSelectors()
        selectors[5] = bytes4(0x3adda78e); // getCutRecord(uint256)
        selectors[6] = bytes4(0xc8d8e114); // isSelectorFrozen(bytes4)
        selectors[7] = bytes4(0x35342750); // previewCut((address,uint8,bytes4[])[])
        selectors[8] = bytes4(0x186f0354); // safe()
        selectors[9] = bytes4(0x5db0cb94); // setSafe(address)
        selectors[10] = bytes4(0x0746a956); // verifyInterfaceRegistered(bytes4)
        cuts[0] = FacetCut(SAFE_DIAMOND_CUT_ADDRESS, FacetCutAction.Add, selectors);

        // EmergencyStop 0.2.0
        selectors = new bytes4[](7);
        selectors[0] = bytes4(0xa526d83b); // addGuardian(address)
        selectors[1] = bytes4(0x93c87f03); // emergencyResume()
        selectors[2] = bytes4(0xb1e3268b); // emergencyStop(string)
        selectors[3] = bytes4(0x0c68ba21); // isGuardian(address)
        selectors[4] = bytes4(0x3f683b6a); // isStopped()
        selectors[5] = bytes4(0x71404156); // removeGuardian(address)
        selectors[6] = bytes4(0x5b0b0c07); // stoppedReason()
        cuts[1] = FacetCut(EMERGENCY_STOP_ADDRESS, FacetCutAction.Add, selectors);

        // AccessControl 0.2.0
        selectors = new bytes4[](5);
        selectors[0] = bytes4(0x248a9ca3); // getRoleAdmin(bytes32)
        selectors[1] = bytes4(0x2f2ff15d); // grantRole(bytes32,address)
        selectors[2] = bytes4(0x91d14854); // hasRole(bytes32,address)
        selectors[3] = bytes4(0x36568abe); // renounceRole(bytes32,address)
        selectors[4] = bytes4(0xd547741f); // revokeRole(bytes32,address)
        cuts[2] = FacetCut(ACCESS_CONTROL_ADDRESS, FacetCutAction.Add, selectors);

        // Receive 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x00000000); // receive()
        cuts[3] = FacetCut(RECEIVE_ADDRESS, FacetCutAction.Add, selectors);

        // DiamondLoupeFacet 0.2.0
        selectors = new bytes4[](4);
        selectors[0] = bytes4(0x7a0ed627); // facets()
        selectors[1] = bytes4(0xadfca15e); // facetFunctionSelectors(address)
        selectors[2] = bytes4(0x52ef6b2c); // facetAddresses()
        selectors[3] = bytes4(0xcdffacc6); // facetAddress(bytes4)
        cuts[4] = FacetCut(DIAMOND_LOUPE_FACET_ADDRESS, FacetCutAction.Add, selectors);

        // ERC165Facet 0.2.0
        selectors = new bytes4[](1);
        selectors[0] = bytes4(0x01ffc9a7); // supportsInterface(bytes4)
        cuts[5] = FacetCut(ERC165_FACET_ADDRESS, FacetCutAction.Add, selectors);
    }

    function _init(address deployer) internal pure returns (address target, bytes memory data) {
        target = SAFE_DIAMOND_CUT_INIT_ADDRESS;
        data = _initStep0(deployer);
    }

    // steps[0]: SafeDiamondCutInit.init(address,address,uint256)
    function _initStep0(address deployer) internal pure returns (bytes memory data) {
        data = abi.encodeWithSelector(
            bytes4(0x86863ec6), deployer, 0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed, uint256(2)
        );
    }
}
"
`;

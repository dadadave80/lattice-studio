{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dadadave80/lattice-studio/main/apps/studio/public/schema/recipe.v1.json",
  "title": "Lattice Studio recipe",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "catalog": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "tag",
        "hash"
      ],
      "additionalProperties": {}
    },
    "template": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "catalogHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "name",
        "catalogHash"
      ],
      "additionalProperties": {}
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{8}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{8}$"
      }
    },
    "init": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bundle"
            },
            "spec": {
              "type": "string"
            },
            "args": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "kind",
            "spec",
            "args"
          ],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "steps"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "spec": {
                    "type": "string"
                  },
                  "args": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                },
                "required": [
                  "spec",
                  "args"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "kind",
            "steps"
          ],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": {}
        }
      ]
    },
    "immutable": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "catalog",
    "facets",
    "owners",
    "exclude",
    "init"
  ],
  "additionalProperties": {},
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "properties": {
            "$ref": {
              "type": "string",
              "enum": [
                "self",
                "deployer"
              ]
            }
          },
          "required": [
            "$ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!\\$ref$)"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}

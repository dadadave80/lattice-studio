{
  "ci": {
    "collect": {
      "startServerCommand": "bun run --cwd apps/studio preview",
      "startServerReadyPattern": "Local:",
      "url": [
        "http://localhost:5173/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
